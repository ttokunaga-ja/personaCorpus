.DS_Store
__pycache__/
*.pyc
.runtime/

# Root-level renderer/debug spill files are never corpus artifacts. Keep exact
# names here so a broad image or JSONL ignore cannot hide accepted files.
/-.jpg
/-.png
/-.ppm
/scratch_rows.jsonl
/scratch_rows.tmp
/created-paths.txt

# Portable canonical authority is shared. The >100 MiB render, Rust
# materialization receipts, and machine-specific copies remain local.
canonical/*
!canonical/persona-plan.json
!canonical/persona-schedule.json

# Accepted final corpus artifacts are Git-managed. Rust owner/lease topology
# and workspace plan copies remain local to each production machine.
workspace/*
!workspace/people/
workspace/people/*
!workspace/people/*/
workspace/people/*/*
!workspace/people/*/home/
!workspace/people/*/home/**

scratch/

# Only portable, token-free assignment and acceptance records are shared.
progress/*
!progress/README.md
!progress/p[0-9][0-9]/
progress/p[0-9][0-9]/*
!progress/p[0-9][0-9]/m1-assignments.md
!progress/p[0-9][0-9]/m1-assignment-ledger.jsonl
!progress/p01/m1-assignment-ledger-v2.jsonl
!progress/p[0-9][0-9]/full/
progress/p[0-9][0-9]/full/*
!progress/p[0-9][0-9]/full/content-spine.md
!progress/p[0-9][0-9]/full/canonical-source-inventory.jsonl
!progress/p[0-9][0-9]/full/m1-reservations.jsonl
!progress/p[0-9][0-9]/full/m1-reservation-reconciliation.jsonl
!progress/p14/full/m1-classification-reconciliation.jsonl
progress/p01/full/m1-reservations.jsonl
!progress/p01/full/m1-reservations-v3.jsonl
!progress/p[0-9][0-9]/full/full-assignment-ledger.jsonl
!progress/p[0-9][0-9]/full/checkpoints/
!progress/p[0-9][0-9]/full/checkpoints/*.json
!progress/p[0-9][0-9]/full/manifests/
!progress/p[0-9][0-9]/full/manifests/*.jsonl

# p02 raw checkpoints contain local render-receipt paths. Acceptance is shared
# through the portable wave manifests; keep the machine-specific receipts local.
progress/p02/full/checkpoints/

# p01's portable, token-free structure revision is current path authority.
# Keep the allowlist exact so temporary renders and machine receipts remain local.
!progress/p01/full/revisions/
progress/p01/full/revisions/*
!progress/p01/full/revisions/v2/
progress/p01/full/revisions/v2/*
!progress/p01/full/revisions/v2/path-revision.jsonl
!progress/p01/full/revisions/v2/format-audit.json
!progress/p01/full/revisions/v2/p01-full-structure-v2.after.jsonl
!progress/p01/full/revisions/v2/structure-policy.md
!progress/p01/full/revisions/v2/migration-report.md

# p02's portable, token-free structure revision is current path authority.
# Keep the allowlist exact so temporary renders and machine receipts remain local.
!progress/p02/full/revisions/
progress/p02/full/revisions/*
!progress/p02/full/revisions/v2/
progress/p02/full/revisions/v2/*
!progress/p02/full/revisions/v2/path-revision.jsonl
!progress/p02/full/revisions/v2/format-audit.json
!progress/p02/full/revisions/v2/p02-full-structure-v2.after.jsonl
!progress/p02/full/revisions/v2/structure-policy.md
!progress/p02/full/revisions/v2/migration-report.md
# p03 portable, token-free QA, structure, and JSONL remediation authority.
# Keep exact exceptions so duplicate predecessor copies and local receipts stay ignored.
!progress/p03/full/revisions/
progress/p03/full/revisions/*
!progress/p03/full/revisions/qa-v2/
progress/p03/full/revisions/qa-v2/*
!progress/p03/full/revisions/qa-v2/m1-baseline-exception-report.json
!progress/p03/full/revisions/qa-v2/portable-qa-summary.json
!progress/p03/full/revisions/qa-v2/remediation-before.jsonl
!progress/p03/full/revisions/qa-v2/remediation-after.jsonl
!progress/p03/full/revisions/qa-v2/remediation-diff-ledger.jsonl
!progress/p03/full/revisions/structure-v2/
progress/p03/full/revisions/structure-v2/*
!progress/p03/full/revisions/structure-v2/format-audit.json
!progress/p03/full/revisions/structure-v2/migration-report.md
!progress/p03/full/revisions/structure-v2/p03-full-structure-v2.after.jsonl
!progress/p03/full/revisions/structure-v2/path-revision.jsonl
!progress/p03/full/revisions/structure-v2/portable-summary.json
!progress/p03/full/revisions/structure-v2/reference-audit.json
!progress/p03/full/revisions/structure-v2/structure-policy.md
!progress/p03/full/revisions/jsonl-format-v1/
progress/p03/full/revisions/jsonl-format-v1/*
!progress/p03/full/revisions/jsonl-format-v1/final-manifest.jsonl
