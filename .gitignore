.DS_Store
__pycache__/
*.pyc
.runtime/

# Root-level renderer/debug spill files are never corpus artifacts. Keep exact
# names here so a broad image or JSONL ignore cannot hide accepted files.
/-.jpg
/-.png
/-.ppm
/scratch_rows.jsonl
/scratch_rows.tmp

# Portable canonical authority is shared. The >100 MiB render, Rust
# materialization receipts, and machine-specific copies remain local.
canonical/*
!canonical/persona-plan.json
!canonical/persona-schedule.json

# Accepted final corpus artifacts are Git-managed. Rust owner/lease topology
# and workspace plan copies remain local to each production machine.
workspace/*
!workspace/people/
workspace/people/*
!workspace/people/*/
workspace/people/*/*
!workspace/people/*/home/
!workspace/people/*/home/**

scratch/

# Only portable, token-free assignment and acceptance records are shared.
progress/*
!progress/README.md
!progress/p[0-9][0-9]/
progress/p[0-9][0-9]/*
!progress/p[0-9][0-9]/m1-assignments.md
!progress/p[0-9][0-9]/m1-assignment-ledger.jsonl
!progress/p01/m1-assignment-ledger-v2.jsonl
!progress/p[0-9][0-9]/full/
progress/p[0-9][0-9]/full/*
!progress/p[0-9][0-9]/full/content-spine.md
!progress/p[0-9][0-9]/full/canonical-source-inventory.jsonl
!progress/p[0-9][0-9]/full/m1-reservations.jsonl
!progress/p[0-9][0-9]/full/m1-reservation-reconciliation.jsonl
progress/p01/full/m1-reservations.jsonl
!progress/p01/full/m1-reservations-v3.jsonl
!progress/p[0-9][0-9]/full/full-assignment-ledger.jsonl
!progress/p[0-9][0-9]/full/checkpoints/
!progress/p[0-9][0-9]/full/checkpoints/*.json
!progress/p[0-9][0-9]/full/manifests/
!progress/p[0-9][0-9]/full/manifests/*.jsonl

# p01's portable, token-free structure revision is current path authority.
# Keep the allowlist exact so temporary renders and machine receipts remain local.
!progress/p01/full/revisions/
progress/p01/full/revisions/*
!progress/p01/full/revisions/v2/
progress/p01/full/revisions/v2/*
!progress/p01/full/revisions/v2/path-revision.jsonl
!progress/p01/full/revisions/v2/format-audit.json
!progress/p01/full/revisions/v2/p01-full-structure-v2.after.jsonl
!progress/p01/full/revisions/v2/structure-policy.md
!progress/p01/full/revisions/v2/migration-report.md
