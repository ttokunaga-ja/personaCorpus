#!/usr/bin/env -S uv run python
"""Read-only corpus checks. Reports contain failures only, never skipped checks."""
import argparse
from collections import Counter, defaultdict
import concurrent.futures
import csv
import datetime as dt
import email
import email.policy
import hashlib
import html.parser
import importlib
import io
import math
import os
from pathlib import Path
import re
import shutil
import struct
import subprocess
import sys
import tempfile
import time
import unicodedata
import xml.etree.ElementTree as ET
import zipfile
from zoneinfo import ZoneInfo

BASE = Path(__file__).resolve().parents[1]
EXT = set('docx pdf xlsx csv tsv pptx txt md log eml html png jpg json xml wav mp3 m4a zip'.split())
BAD_PATH = re.compile(r'foundation|visual|source-art|full|(?<![a-z0-9])m1(?![a-z0-9])|primary|secondary|pdf_scan|pdf_text|txt_log|csv_tsv|html_eml|structured_text|domain_binary|imagegen', re.I)
TRACE = re.compile(r'(?<!\w)(?:kio(?:-eval)?|personacorpus|persona|corpus|fixture|content\s+spine|synthetic|fictional|not\s+a\s+real|artifact\s+id|source\s+id|batch|scope\s+(?=[\w-]*\d)[\w-]+|p\d{2}-[\w-]+|lorem\s+ipsum|placeholder)(?!\w)|/Users/|scratch/', re.I)
SECRET = re.compile(rb'(?:AKIA|ASIA)[0-9A-Z]{16}|(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{20,}|(?:xox[baprs]|xapp)-[A-Za-z0-9-]{10,}|(?:hvs\.|hvb\.|s\.)[A-Za-z0-9_-]{20,}|-----BEGIN (?:RSA |EC |DSA |OPENSSH |ENCRYPTED |PGP )?PRIVATE KEY(?: BLOCK)?-----|sk-[A-Za-z0-9_-]{20,}|eyJ[A-Za-z0-9_-]+\.eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+|/ASCII85Decode')
COMMANDS = ('pdftotext','pdfinfo','pdftoppm','tesseract','soffice','ffprobe')
LIBRARIES = ('docx','openpyxl','pptx','reportlab','pypdf','PIL')


def options(parser):
    for name in ('root','personas','progress','manifests','sources'):
        parser.add_argument('--'+name,type=Path,default=BASE/('people' if name=='root' else name))


def personas(root):
    if not root.is_dir():
        raise ValueError(f'root not found: {root}')
    names=sorted(p.name for p in root.iterdir() if p.is_dir() and not p.is_symlink() and re.fullmatch(r'p\d{2}-.+',p.name))
    if not names:
        raise ValueError('no personas')
    return names


def resolve(root,name,definitions=None):
    candidates = [p.stem for p in definitions.glob('p[0-9][0-9]-*.md')] if definitions is not None else personas(root)
    names=[n for n in candidates if n==name or re.fullmatch(r'p\d{2}',name) and n.startswith(name+'-')]
    if len(names)!=1:
        raise ValueError(f'persona not found or ambiguous: {name}')
    if (root/names[0]).is_symlink():
        raise ValueError('persona folder is a symlink: ' + names[0])
    return names[0]


def files(folder):
    """All leaf files, including hidden/unsupported files; never follow links."""
    found=[]
    for parent,dirs,names in os.walk(folder,followlinks=False):
        for name in list(dirs):
            p=Path(parent)/name
            if p.is_symlink():
                found.append(p);dirs.remove(name)
        found.extend(Path(parent)/n for n in names)
    return sorted(found)


def config(path):
    if not path.exists():
        print(f'定義なし：{path}（期間検査・許可語なし）',file=sys.stderr)
        return {}
    text=path.read_text(encoding='utf-8-sig')
    cfg={}
    if text.startswith('---\n'):
        for line in text.split('\n---',1)[0][4:].splitlines():
            if ':' in line:
                key,value=line.split(':',1);cfg[key.strip()]=value.strip()
    return cfg


def command(args):
    result=subprocess.run(list(map(str,args)),stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=120)
    if result.returncode:
        raise ValueError(f'{args[0]} exit {result.returncode}: '+result.stderr.decode(errors='replace')[:240])
    return result.stdout


class TextHTML(html.parser.HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True);self.parts=[];self.hidden=0
    def handle_starttag(self,tag,attrs):
        if tag in ('script','style'):self.hidden+=1
    def handle_endtag(self,tag):
        if tag in ('script','style'):self.hidden=max(0,self.hidden-1)
    def handle_data(self,data):
        if not self.hidden:self.parts.append(data)


def html_text(text):
    parser=TextHTML();parser.feed(text);return ' '.join(parser.parts)


def ocr(path,language):
    return command(['tesseract',path,'stdout','-l',language]).decode('utf-8',errors='replace')


def extract(path,ext,language=None):
    """Return body, image-only flag, skipped OCR flag. Decode errors are opens failures."""
    if ext in ('docx','xlsx','pptx'):
        main={'docx':'word/document.xml','xlsx':'xl/workbook.xml','pptx':'ppt/presentation.xml'}[ext]
        with zipfile.ZipFile(path) as z:
            names=set(z.namelist())
            required={'[Content_Types].xml','_rels/.rels',main}
            if not required<=names or z.testzip():raise ValueError('missing or corrupt Office parts')
            texts=[]
            for n in sorted(names):
                if n.endswith('.xml') or n.endswith('.rels'):
                    root=ET.fromstring(z.read(n))
                    if n==main and root.tag.rsplit('}',1)[-1]!={'docx':'document','xlsx':'workbook','pptx':'presentation'}[ext]:
                        raise ValueError('incorrect Office root element')
                    # Relationships must resolve, including worksheets/slides referenced by main.
                    if n.endswith('.rels'):
                        import posixpath
                        base=posixpath.dirname(posixpath.dirname(n))
                        for rel in root:
                            target=rel.get('Target','')
                            if rel.get('TargetMode')!='External' and target:
                                dest=posixpath.normpath(posixpath.join(base,target)) if not target.startswith('/') else target[1:]
                                if dest not in names:raise ValueError('missing Office relationship target: '+dest)
                    if n.startswith(('word/','ppt/','xl/')):
                        # Runs inside a paragraph/cell are contiguous on screen.
                        # Separate logical units, rather than inserting spaces between runs.
                        units=[x for x in root.iter() if x.tag.rsplit('}',1)[-1] in ('p','si','c')]
                        if units:
                            texts.extend(''.join((x.text or '') if x.tag.rsplit('}',1)[-1] in ('t','v','delText') else '\n' if x.tag.rsplit('}',1)[-1]=='br' else '\t' if x.tag.rsplit('}',1)[-1]=='tab' else '' for x in unit.iter()) for unit in units)
                        else:
                            texts.extend(x.text for x in root.iter() if x.text and x.tag.rsplit('}',1)[-1] in ('t','v','delText'))
            return ' '.join(texts),False,False
    if ext=='pdf':
        command(['pdfinfo',path])
        text=command(['pdftotext',path,'-']).decode('utf-8',errors='strict')
        pages=text.split('\f')
        if pages and not pages[-1].strip():pages.pop()
        blanks=[i+1 for i,p in enumerate(pages) if not p.strip()]
        if not blanks and not text.strip():blanks=[1]
        image_only=bool(blanks) and not text.strip()
        if blanks and language:
            with tempfile.TemporaryDirectory(prefix='corpus-ocr-') as d:
                for i in blanks:
                    prefix=Path(d)/f'page-{i}'
                    command(['pdftoppm','-f',i,'-l',i,'-singlefile','-r','150','-png',path,prefix])
                    text+='\n'+ocr(prefix.with_suffix('.png'),language)
        return text,image_only,bool(blanks and not language)
    if ext in ('png','jpg'):
        from PIL import Image
        with Image.open(path) as im:
            if im.format!={'png':'PNG','jpg':'JPEG'}[ext]:raise ValueError('image format mismatch')
            im.verify()
        with Image.open(path) as im:im.load()
        return ocr(path,language) if language else '',True,not language
    if ext in ('wav','mp3','m4a'):
        info=__import__('json').loads(command(['ffprobe','-v','error','-show_format','-show_streams','-show_frames','-of','json',path]))
        fmt=info.get('format',{}).get('format_name','').split(',')
        expected={'wav':{'wav'},'mp3':{'mp3'},'m4a':{'mov','mp4','m4a'}}[ext]
        if not expected.intersection(fmt) or not any(s.get('codec_type')=='audio' for s in info.get('streams',[])) or not info.get('frames'):
            raise ValueError('audio header or frame decoding failed')
        return '',False,False
    if ext=='zip':
        with zipfile.ZipFile(path) as z:
            if z.testzip():raise ValueError('corrupt ZIP member')
        return '',False,False
    raw=path.read_bytes()
    if ext=='eml':
        msg=email.message_from_bytes(raw,policy=email.policy.default)
        if not all(msg.get(k) for k in ('From','To','Subject')) or msg.defects or any(h.defects for h in msg.values() if hasattr(h,'defects')):
            raise ValueError('invalid email headers')
        parts=[f'{k}: {v}' for k,v in msg.items()]
        for part in msg.walk():
            if part.get_content_maintype()=='text' and not part.is_multipart():
                content=part.get_content();parts.append(html_text(content) if part.get_content_subtype()=='html' else content)
        return '\n'.join(parts),False,False
    text=raw.decode('utf-8-sig')
    if ext=='json':__import__('json').loads(text)
    elif ext=='xml':ET.fromstring(text)
    elif ext in ('csv','tsv'):
        rows=csv.reader(io.StringIO(text),delimiter=',' if ext=='csv' else '\t',strict=True)
        width=None
        for row in rows:
            if width is None:width=len(row)
            if not row or len(row)!=width:raise ValueError('inconsistent column count')
    elif ext=='html':text=html_text(text)
    if '\x00' in text:raise ValueError('NUL in text')
    return text,False,False


def shingles(text):
    # Dates and numeric identifiers carry no distinguishing information.
    text=re.sub(r'\d+','0',text.casefold())
    # CJK text has no spaces, so each CJK character counts as a word.
    words=re.findall(r'[\u3040-\u30ff\u3400-\u9fff]|[^\W_\u3040-\u30ff\u3400-\u9fff]+',text)
    return frozenset(int.from_bytes(hashlib.blake2b(' '.join(words[i:i+5]).encode(),digest_size=8).digest(),'big') for i in range(len(words)-4))


def source_document(root, rel, chain=()):
    """Resolve delta-only derived manuscripts without duplicating the base body."""
    if Path(rel).is_absolute() or '..' in Path(rel).parts:raise ValueError('unsafe derived_from path')
    if rel in chain:raise ValueError('derived_from cycle: '+rel)
    root=root.absolute();path=root/(rel+'.md')
    if not path.resolve().is_relative_to(root.resolve()) or any(p.is_symlink() for p in (path,*path.parents) if p==root or p.is_relative_to(root)):
        raise ValueError('source path escapes root or contains symbolic link')
    text=path.read_text(encoding='utf-8-sig');cfg={}
    if not text.startswith('---\n'):raise ValueError('source front matter missing')
    head,sep,text=text[4:].partition('\n---\n')
    if not sep:raise ValueError('unclosed source front matter')
    for line in head.splitlines():
        if ':' in line:
            k,v=line.split(':',1);cfg[k.strip()]=v.strip().strip("\"'")
    parent=cfg.get('derived_from','')
    if parent:text=source_document(root,parent,chain+(rel,))[1]+'\n'+text
    if not text.strip() and cfg.get('kind')!='photo':raise ValueError('empty source body')
    return cfg,text


def body_tokens(text):
    return Counter(re.findall(r'[\u3040-\u30ff\u3400-\u9fff]|[^\W_\u3040-\u30ff\u3400-\u9fff]+',unicodedata.normalize('NFKC',text).casefold()))


def source_numbers(text):
    """Numbers of four or more integer digits, independent of separators and trailing zeros."""
    text=re.sub(r'(?<=\d),(?=\d{3})','',unicodedata.normalize('NFKC',text))
    found=set()
    for whole,frac in re.findall(r'(?<![\d.])(\d{4,})(?:\.(\d+))?(?![\d])',text):
        if len(whole)==4 and 1900<=int(whole)<=2100:continue  # years appear in many date formats
        frac=frac.rstrip('0')
        found.add(whole.lstrip('0')+('.'+frac if frac else ''))
    return found


def source_body(text):
    """Drop manuscript-only formulas and numeric Markdown row labels."""
    text = re.sub(r'`+\s*=[^`\n]*`+', '', text)
    lines = text.splitlines(); result = []; i = 0
    def cells(line):
        return [c.strip() for c in re.split(r'(?<!\\)\|', line.strip().strip('|'))]
    while i < len(lines):
        if '|' in lines[i] and i+1 < len(lines) and all(re.fullmatch(r':?-+:?', c) for c in cells(lines[i+1])):
            header = cells(lines[i]); rows = []; j = i+2
            while j < len(lines) and '|' in lines[j] and lines[j].strip():
                rows.append(cells(lines[j])); j += 1
            remove = {k for k,c in enumerate(header) if c.strip('` ') in ('行','#','No.')
                      and rows and all(len(row)==len(header) and re.fullmatch(r'`?\d+`?', row[k]) for row in rows)}
            for row in [header, *rows]:
                result.append(' | '.join('' if c.lstrip('` ').startswith('=') else c for k,c in enumerate(row) if k not in remove))
            i = j
        else:
            if not all(re.fullmatch(r':?-+:?', c) for c in cells(lines[i])):
                result.append('' if lines[i].strip().startswith('=') else lines[i])
            i += 1
    return '\n'.join(result)


def formula_reason(path):
    ns = '{http://schemas.openxmlformats.org/spreadsheetml/2006/main}'
    with zipfile.ZipFile(path) as archive:
        for name in archive.namelist():
            if not name.startswith('xl/worksheets/') or not name.endswith('.xml'):continue
            for cell in ET.fromstring(archive.read(name)).iter(ns+'c'):
                if cell.find(ns+'f') is None:continue
                value = cell.find(ns+'v'); kind = cell.get('t')
                label = name + ':' + cell.get('r','?')
                if value is None or (value.text is None and kind != 'str'):
                    return label + ': formula cached result missing'
                if kind == 'e' or value.text in ('#REF!','#DIV/0!','#VALUE!','#NAME?','#N/A'):
                    return label + ': formula error ' + (value.text or '')
    return None


def source_reason(expected, actual, *, from_ocr=False, ext="txt", reviewed=False, derived=False):
    # The mechanical check catches dropped content; exact wording is the visual review's job.
    strip=lambda s:re.sub(r'(?<=\d),(?=\d{3})','',s)
    words=lambda s:Counter({k:v for k,v in body_tokens(strip(s)).items() if k not in ('年','月','日','円')})
    expected=source_body(expected)
    want=words(expected);have=words(actual)
    overlap=sum((want & have).values())/sum(want.values()) if want else 1
    if not (from_ocr or derived):
        numbers=source_numbers(expected)
        missing=sorted(numbers-source_numbers(actual))
        if len(missing)>len(numbers)//20:return 'missing source values: '+', '.join(missing[:5])
    threshold=.3 if from_ocr else .6 if reviewed else .5 if derived else .6 if ext in ('xlsx','csv','tsv') else .7 if ext=='pptx' else .8
    if overlap<threshold:return f'body token overlap {overlap:.3f} < {threshold}'
    return None


def docx_reviewed(path):
    """Revision or comment markup changes the manuscript coverage denominator."""
    with zipfile.ZipFile(path) as archive:
        for name in archive.namelist():
            if name.startswith('word/') and name.endswith('.xml'):
                root=ET.fromstring(archive.read(name))
                if any(node.tag.rsplit('}',1)[-1] in ('ins','del','moveFrom','moveTo','comment','commentRangeStart','commentReference') for node in root.iter()):
                    return True
    return False


def metadata(path, ext, cfg, mtime):
    """Inspect internal properties only; filesystem times remain the mtime check."""
    entries=[]
    def xml_entries(raw,label):
        def walk(node,parent):
            key=parent+':'+node.tag.rsplit('}',1)[-1]
            if node.text and node.text.strip():entries.append((key,node.text.strip()))
            entries.extend((key+':'+k.rsplit('}',1)[-1],v) for k,v in node.attrib.items())
            for child in node:walk(child,key)
        walk(ET.fromstring(raw),label)
    if ext in ('docx','xlsx','pptx'):
        with zipfile.ZipFile(path) as z:
            for name in z.namelist():
                if name.startswith('docProps/') and name.endswith('.xml'):xml_entries(z.read(name),name)
                elif name.endswith('.xml') and name.startswith(('word/','xl/','ppt/')):
                    root=ET.fromstring(z.read(name))
                    for node in root.iter():
                        # Comment/revision author and dates occur as XML attributes.
                        local=node.tag.rsplit('}',1)[-1]
                        if local=='author' and node.text:entries.append((name+':author',node.text))
                        for k,v in node.attrib.items():
                            key=k.rsplit('}',1)[-1]
                            if key in ('author','date','initials') or 'commentAuthor' in local and key=='name':entries.append((name+':'+('author' if key=='name' else key),v))
    elif ext=='pdf':
        from pypdf import PdfReader
        reader=PdfReader(path)
        entries.extend((str(k).lstrip('/'),str(v)) for k,v in (reader.metadata or {}).items())
        xmp=reader.trailer['/Root'].get('/Metadata')
        if xmp:xml_entries(xmp.get_object().get_data(),'XMP')
    elif ext in ('png','jpg'):
        from PIL import Image, ExifTags
        with Image.open(path) as im:
            for k,v in im.info.items():
                if 'xmp' in k.casefold() and isinstance(v,(str,bytes)):xml_entries(v,'XMP')
                elif isinstance(v,(str,int,float)):entries.append((str(k),str(v)))
            exif=im.getexif()
            for k,v in exif.items():entries.append((ExifTags.TAGS.get(k,str(k)),str(v)))
            for tag in (34665,34853):
                if tag in exif:
                    for k,v in exif.get_ifd(tag).items():entries.append((ExifTags.TAGS.get(k,str(k)),str(v)))
    tool=re.compile(r'python[- ]?(?:docx|pptx)?|openpyxl|reportlab|pypdf|pillow|matplotlib|codex|chatgpt|openai|imagegen|(?:lua|pdf|xe)?latex|(?:lua|pdf|xe)tex|tesseract|ghostscript|libreoffice',re.I)
    user=os.environ.get('USER','')
    trace=re.compile(r'/Users/|/home/|/tmp/|(?:[A-Z]:[\\/](?:Users|Temp)[\\/])|scratch/|'+re.escape(str(BASE)),re.I)
    local_zone=ZoneInfo(cfg.get('timezone','UTC'))
    offsets={k:v for k,v in entries if k in ('OffsetTime','OffsetTimeOriginal','OffsetTimeDigitized')}
    for key,value in entries:
        identity=ext in ('png','jpg') or bool(re.search(r'author|creator|lastModifiedBy|Application|producer|company|manager|initials',key,re.I))
        if identity and (tool.search(value) or trace.search(value) or user and len(user)>2 and re.search(r'(?<!\w)'+re.escape(user)+r'(?!\w)',value,re.I)):
            return f'production metadata {key}: {value[:180]}'
        if re.search(r'date|created|modified|creation|lastprinted|datetime',key,re.I):
            stamp=None
            pdf=re.match(r'(?:D:)?(\d{4})(\d{2})(\d{2})(\d{2})?(\d{2})?(\d{2})?',value)
            try:
                if pdf:
                    nums=[int(v or 0) for v in pdf.groups()];stamp=dt.datetime(*nums,tzinfo=dt.timezone.utc if value.endswith('Z') else local_zone)
                    zone=re.search(r"([+-])(\d{2})'?(\d{2})'?",value[pdf.end():])
                    if zone:stamp=stamp.replace(tzinfo=dt.timezone(dt.timedelta(minutes=(1 if zone[1]=='+' else -1)*(int(zone[2])*60+int(zone[3])))))
                else:
                    val=re.sub(r'^(\d{4}):(\d{2}):(\d{2})',r'\1-\2-\3',value)
                    offset=offsets.get({'DateTime':'OffsetTime','DateTimeOriginal':'OffsetTimeOriginal','DateTimeDigitized':'OffsetTimeDigitized'}.get(key,''),'')
                    if offset:val+=offset
                    stamp=dt.datetime.fromisoformat(val.replace('Z','+00:00'))
                    if stamp.tzinfo is None:stamp=stamp.replace(tzinfo=local_zone)
            except ValueError:continue
            if cfg.get('period'):
                start,end=cfg['period'].split('..')
                if not dt.date.fromisoformat(start)<=stamp.astimezone(dt.timezone.utc).date()<=dt.date.fromisoformat(end):return f'{key}: outside persona period: {value}'
            if stamp.timestamp()>mtime:return f'{key}: later than file mtime: {value}'
    return None


def inspect(item):
    path,folder,cfg,language,source_root=item
    rel=path.relative_to(folder).as_posix();issues={};skipped=[];text='';digest=None
    def fail(kind,reason):issues.setdefault(kind,str(reason).replace('\n',' ')[:400])
    ext=path.suffix.lower().lstrip('.')
    try:
        if path.is_symlink():
            fail('format','symbolic link');return rel,issues,None,frozenset(),skipped
        st=path.stat()
        if ext not in EXT or any(p.startswith('.') for p in Path(rel).parts) or st.st_size==0:
            fail('format','unsupported extension, hidden path, or zero bytes')
        if BAD_PATH.search(rel) or re.search(r'(?<![a-z0-9])p\d{2}(?!\d)|-s\d{6}(?!\d)|(?<!\d)\d{5,}(?!\d)',path.name,re.I):
            fail('path','production category or identifier in path')
        h=hashlib.sha256();tail=b''
        with path.open('rb') as f:
            for block in iter(lambda:f.read(1024*1024),b''):
                h.update(block)
                if SECRET.search(tail+block):fail('secret','secret-like bytes or PDF ASCII85 filter')
                tail=block[-4096:]
        digest=h.digest()
        if ext in EXT and st.st_size:
            try:
                text,scan,missing=extract(path,ext,language)
                if ext=='xlsx':
                    reason=formula_reason(path)
                    if reason:fail('formula',reason)
                photo=any(rel.startswith(x.strip().rstrip('/')+'/') for x in cfg.get('photo_dirs','').split(',') if x.strip())
                try:
                    reason=metadata(path,ext,cfg,st.st_mtime)
                    if reason:fail('metadata',reason)
                except Exception as e:fail('metadata',f'{type(e).__name__}: {e}')
                try:
                    scfg,body=source_document(source_root,rel)
                    visual_source=bool({'photo','handwriting','chart','diagram'} & set(scfg.get('kind','').split(':')))
                    if not visual_source:
                        if missing:skipped.append('source(OCR)')
                        else:
                            reason=source_reason(body,text,from_ocr=scan,ext=ext,reviewed=ext=='docx' and docx_reviewed(path),derived=bool(scfg.get('derived_from')))
                            if reason:fail('source',reason)
                except Exception as e:fail('source',f'{type(e).__name__}: {e}')
                if missing:
                    if not photo:skipped.append('empty-scan')
                    skipped.extend(('trace(OCR)','secret(OCR)','duplicate(OCR)'))
                if scan and not missing and not photo and len(re.sub(r'\s','',text))<20:
                    fail('empty-scan','OCR contains fewer than 20 non-whitespace characters')
                if SECRET.search(text.encode()):fail('secret','secret-like extracted text')
                traced=rel+'\n'+text
                allowed=[m.span() for term in cfg.get('allowed_terms','').split(',') if len(term.split())>=2 for m in re.finditer(r'(?<!\w)'+r'\s+'.join(re.escape(w) for w in term.split())+r'(?!\w)',traced,re.I)]
                for m in TRACE.finditer(traced):
                    if not any(a<=m.start() and m.end()<=b for a,b in allowed):
                        fail('trace','production trace: '+m.group());break
            except Exception as e:fail('opens',f'{type(e).__name__}: {e}')
        if cfg.get('period'):
            start,end=cfg['period'].split('..')
            day=dt.datetime.fromtimestamp(st.st_mtime,dt.timezone.utc).date()
            if not dt.date.fromisoformat(start)<=day<=dt.date.fromisoformat(end):fail('mtime','outside persona period (UTC)')
    except Exception as e:fail('opens',f'{type(e).__name__}: {e}')
    return rel,issues,digest,shingles(text),skipped


def duplicates(results, derived=None):
    """Exact Jaccard prefix join at .8; rarest shingles first, identical sets collapsed.

    A qualifying pair must share a prefix token. Size filtering and intersection
    verification avoid all-pairs comparisons. No MinHash false negatives.
    """
    derived=derived or {}
    def related(i,j):
        a,b=results[i][0],results[j][0]
        left,right=derived.get(a,()),derived.get(b,())
        if isinstance(left,str):left=(left,)
        if isinstance(right,str):right=(right,)
        return b in left or a in right
    def mark_pair(left,right,reason,exact=False):
        for group,other in ((left,right),(right,left)):
            for i in group:
                if 'duplicate' in results[i][1]:continue
                match=next((j for j in other if i!=j and results[i][0]!=results[j][0] and (exact or not related(i,j))),None)
                if match is not None:results[i][1]['duplicate']=reason+': '+results[match][0]
    hashes=defaultdict(list);groups=defaultdict(list)
    for i,(_,_,digest,grams,_) in enumerate(results):
        if digest is not None:hashes[digest].append(i)
        if grams:groups[grams].append(i)
    for indices in hashes.values():
        if len(indices)>1:mark_pair(indices,indices,'identical bytes',exact=True)
    for indices in groups.values():
        if len(indices)>1:mark_pair(indices,indices,'identical normalized shingles')
    frequency=Counter(g for grams in groups for g in grams)
    index=defaultdict(list)
    for grams,indices in sorted(groups.items(),key=lambda x:len(x[0])):
        n=len(grams);prefix=sorted(grams,key=lambda g:(frequency[g],g))[:n-math.ceil(.8*n)+1]
        candidates=set()
        for g in prefix:
            for other in index[g]:
                if 5*len(other)>=4*n:candidates.add(other)
        for other in candidates:
            intersection=len(grams & other)
            if 5*intersection>=4*(n+len(other)-intersection):
                mark_pair(indices,groups[other],'normalized 5-word Jaccard >= 0.8')
        for g in prefix:index[g].append(grams)


def plan(path, relations=None):
    lines=path.read_text(encoding='utf-8').splitlines();result={};indices=None
    for line in lines:
        if not line.strip().startswith('|'):continue
        cells=[c.strip().strip('`') for c in re.split(r'(?<!\\)\|',line.strip().strip('|'))]
        if all(c in cells for c in ('パス','日付','内容','関連')):
            indices=[cells.index(c) for c in ('パス','日付','内容')]
            links=[cells.index(c) for c in ('関連','先に要るもの') if c in cells]
            continue
        if indices is None or all(re.fullmatch(r':?-+:?',c) for c in cells):continue
        if len(cells)<=max(indices):raise ValueError('malformed plan row')
        rel,date,content=[cells[i] for i in indices]
        if relations is not None:
            for index in links:
                if index<len(cells):
                    relations[rel].update(value.strip().strip('`') for value in re.split(r'[,、;；\n]+',cells[index]) if value.strip().strip('`'))
        if content.startswith(('破棄：','成形待ち：')):continue
        if not rel or Path(rel).is_absolute() or '..' in Path(rel).parts:raise ValueError('unsafe plan path')
        if rel in result:raise ValueError('duplicate plan path: '+rel)
        result[rel]=date
    if indices is None:raise ValueError('plan table not found')
    return result


def plan_relations(folder):
    """Read direct content relationships across every batch plan for this persona."""
    relations=defaultdict(set)
    for path in sorted(folder.glob('*.md')):
        if path.name.endswith(('.request.md','.result.md')) or path.stem=='facts':continue
        try:plan(path,relations)
        except ValueError:continue
    return relations


def tracked(folder):
    """Read Git index v2/3/4 without adding Git as a runtime command dependency."""
    root=folder.resolve()
    while not (root/'.git').exists():
        if root==root.parent:return set()
        root=root.parent
    gitdir=root/'.git'
    if gitdir.is_file():gitdir=(root/gitdir.read_text().strip().removeprefix('gitdir: ')).resolve()
    path=gitdir/'index'
    if not path.exists():return set()
    raw=path.read_bytes();signature,version,count=struct.unpack_from('>4sII',raw)
    if signature!=b'DIRC' or version not in (2,3,4):raise ValueError('unsupported Git index')
    pos=12;previous=b'';paths=set()
    for _ in range(count):
        start=pos;flags=struct.unpack_from('>H',raw,pos+60)[0];pos+=62
        if flags&0x4000:pos+=2
        if version==4:
            byte=raw[pos];pos+=1;remove=byte&0x7f
            while byte&0x80:
                byte=raw[pos];pos+=1;remove=((remove+1)<<7)+(byte&0x7f)
            end=raw.index(b'\0',pos);name=previous[:len(previous)-remove]+raw[pos:end];pos=end+1
        else:
            end=raw.index(b'\0',pos);name=raw[pos:end];pos=start+((end+1-start+7)//8)*8
        previous=name
        p=root/os.fsdecode(name)
        if p.is_relative_to(folder.resolve()):paths.add(p.relative_to(folder.resolve()).as_posix())
    while pos+8<=len(raw)-20:
        kind=raw[pos:pos+4];size=struct.unpack_from('>I',raw,pos+4)[0];pos+=8+size
        if kind==b'link':raise ValueError('split Git index unsupported; cannot certify untracked files')
    return paths


def run(a):
    names=getattr(a,'accepted_personas',None) or (personas(a.root) if a.all else [resolve(a.root,a.persona,a.personas)])
    started=time.monotonic();failures=[];passed=0;pending=0;failed_files=set();skips=Counter()
    language=None
    if shutil.which('tesseract'):
        langs=command(['tesseract','--list-langs']).decode(errors='replace').splitlines()
        language='eng+jpn' if 'jpn' in langs else 'eng'
    for name in names:
        folder=a.root/name;cfg=config(a.personas/(name+'.md'));paths=files(folder)
        if getattr(a,'accepted_paths',None) is not None:
            paths=[folder/rel for rel in sorted(a.accepted_paths[name])]
        target=plan(a.progress/name/(a.batch+'.md')) if a.batch else None
        local=[]
        if target is not None:
            existing={p.relative_to(folder).as_posix() for p in paths}
            for rel in target.keys()-existing:local.append((rel,'plan','planned file missing'))
            planned=set(target)
            for other in sorted((a.progress/name).glob('*.md')):
                if other.name.endswith(('.request.md','.result.md')) or other.stem in ('facts',a.batch):continue
                try:planned.update(plan(other))
                except ValueError:continue
            for rel in existing-planned-tracked(folder):local.append((rel,'plan','untracked file outside batch plan'))
        results=[];last=time.monotonic()
        with concurrent.futures.ThreadPoolExecutor(max_workers=min(16,os.cpu_count() or 1)) as pool:
            # Bounded submissions: do not allocate 150,000 Future objects.
            for offset in range(0,len(paths),256):
                items=((p,folder,cfg,language,a.sources/name) for p in paths[offset:offset+256])
                results.extend(pool.map(inspect,items))
                if time.monotonic()-last>=5 or len(results)==len(paths):
                    print(f'{name}: {len(results)}/{len(paths)} files, {time.monotonic()-started:.1f}s',file=sys.stderr,flush=True);last=time.monotonic()
        print(f'{name}: duplicate comparison',file=sys.stderr,flush=True)
        derived=plan_relations(a.progress/name)
        for rel,_,_,_,_ in results:
            try:
                scfg,_=source_document(a.sources/name,rel)
                if scfg.get('derived_from'):derived[rel].add(scfg['derived_from'])
            except (OSError,ValueError):pass
        duplicates(results,derived)
        for rel,issues,_,_,skipped in results:
            if target is not None and rel not in target:continue
            skips.update(skipped)
            if target is not None:
                try:
                    expected=dt.datetime.fromisoformat(target[rel].replace('Z','+00:00'))
                    if expected.tzinfo is None:expected=expected.replace(tzinfo=dt.timezone.utc)
                    if abs((folder/rel).stat().st_mtime-expected.timestamp())>=86400:issues['mtime']='differs from plan by at least one day'
                except ValueError:issues['mtime']='invalid plan timestamp'
            local.extend((rel,k,v) for k,v in sorted(issues.items()))
            if not issues:
                if skipped:pending+=1
                else:passed+=1
        for rel,kind,reason in sorted(local):
            row=(name,rel,kind,reason);failures.append(row);failed_files.add((name,rel))
            print('\t'.join(row))
    if a.report:
        a.report.parent.mkdir(parents=True,exist_ok=True)
        with a.report.open('w',encoding='utf-8',newline='') as f:
            csv.writer(f,delimiter='\t',lineterminator='\n').writerows(failures)
    for kind,count in sorted(skips.items()):
        print(f'未実行：{kind}: {count} files（tesseract なし）',file=sys.stderr)
    print(f'passed: {passed}, failed: {len(failed_files)}, pending: {pending}, findings: {len(failures)}, skipped OCR files: {skips.get("trace(OCR)",0)}, elapsed: {time.monotonic()-started:.2f}s')
    return int(bool(failures or skips))


def main():
    p=argparse.ArgumentParser(description=__doc__);options(p)
    p.add_argument('persona',nargs='?');p.add_argument('--all',action='store_true');p.add_argument('--batch');p.add_argument('--report',type=Path);p.add_argument('--self-test',action='store_true')
    a=p.parse_args()
    if a.self_test:
        missing=[n for n in (*COMMANDS, 'lualatex', 'fc-list') if not shutil.which(n)]
        if shutil.which('fc-list'):
            try:
                if not command(['fc-list', ':lang=ja']).strip():missing.append('日本語フォント')
            except Exception:missing.append('日本語フォント')
        for n in LIBRARIES:
            try:importlib.import_module(n)
            except Exception:missing.append(n)
        print('missing: '+', '.join(missing) if missing else 'dependencies available')
        return int(bool(missing))
    if bool(a.persona)==bool(a.all) or a.all and a.batch:p.error('choose persona or --all; --batch requires persona')
    try:return run(a)
    except Exception as e:
        print(f'check: {type(e).__name__}: {e}',file=sys.stderr);return 1

if __name__=='__main__':sys.exit(main())
