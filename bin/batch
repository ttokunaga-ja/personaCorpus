#!/usr/bin/env -S uv run python
"""persona × batch の計画、制作、検査と統括の受入操作。"""
import argparse
from collections import Counter, defaultdict
import contextlib
from concurrent.futures import ThreadPoolExecutor
import threading
import csv
import datetime as dt
import fcntl
import hashlib
import json
import math
import os
from pathlib import Path, PurePosixPath
import re
import shlex
import shutil
import subprocess
import sys
import time
import threading
import xml.etree.ElementTree as ET
import zipfile
from zoneinfo import ZoneInfo

ROOT = Path(__file__).resolve().parents[1]
COLUMNS = ('パス', '日付', '作り方', '内容', '関連', '先に要るもの')
# bin/check の path / trace 契約。検査本体は各 round に bin/check で実行する。
EXT = set('docx pdf xlsx csv tsv pptx txt md log eml html png jpg json xml wav mp3 m4a zip'.split())
BAD_PATH = re.compile(r'foundation|visual|source-art|full|(?<![a-z0-9])m1(?![a-z0-9])|primary|secondary|pdf_scan|pdf_text|txt_log|csv_tsv|html_eml|structured_text|domain_binary|imagegen', re.I)
TRACE = re.compile(r'(?<!\w)(?:kio(?:-eval)?|personacorpus|persona|corpus|fixture|content\s+spine|synthetic|fictional|not\s+a\s+real|artifact\s+id|source\s+id|batch|scope\s+(?=[\w-]*\d)[\w-]+|p\d{2}-[\w-]+|lorem\s+ipsum|placeholder)(?!\w)|/Users/|scratch/', re.I)
IDENTIFIER = re.compile(r'(?<![a-z0-9])p\d{2}(?!\d)|-s\d{6}(?!\d)|(?<!\d)\d{5,}(?!\d)', re.I)


def read(path):
    return path.read_text(encoding='utf-8')


def save(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + '.tmp')
    temporary.write_text(json.dumps(value, ensure_ascii=False, indent=2) + '\n')
    temporary.replace(path)


def config(path):
    text = read(path)
    if not text.startswith('---\n'):
        return {}
    return dict(tuple(x.strip() for x in line.split(':', 1))
                for line in text.split('\n---', 1)[0][4:].splitlines() if ':' in line)


def command(args, *, check=True):
    result = subprocess.run(list(map(str, args)), cwd=ROOT, text=True,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    if check and result.returncode:
        raise ValueError(f'{args[0]} exit {result.returncode}: ' + '\n'.join(result.stdout.splitlines()[-20:]))
    return result


def git(*args):
    return command(['git', *args]).stdout


def persona_name(value):
    names = [p.stem for p in (ROOT / 'personas').glob('p[0-9][0-9]-*.md')
             if p.stem == value or re.fullmatch(r'p\d{2}', value) and p.stem.startswith(value + '-')]
    if len(names) != 1:
        raise ValueError('persona が見つからないか曖昧: ' + value)
    return names[0]


def safe_file(folder, relative):
    p = PurePosixPath(relative)
    if not relative or p.as_posix() != relative or p.is_absolute() or '..' in p.parts or '\\' in relative or any(x.startswith('.') for x in p.parts):
        raise ValueError('安全でないパス: ' + relative)
    target = folder / relative
    if not target.resolve().is_relative_to(folder.resolve()) or any(x.is_symlink() for x in [target, *target.parents] if x.is_relative_to(folder)):
        raise ValueError('リンクを含むパス: ' + relative)
    return target


@contextlib.contextmanager
def persona_lock(persona, wait=False, shared=False):
    path = ROOT / 'scratch' / persona / '.lock'
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('a') as handle:
        try:
            fcntl.flock(handle, (fcntl.LOCK_SH if shared else fcntl.LOCK_EX) | (0 if wait else fcntl.LOCK_NB))
        except BlockingIOError:
            raise ValueError('同じ persona の batch が進行中: ' + persona) from None
        yield


_repository_locks = threading.local()


@contextlib.contextmanager
def repository_lock(name='records'):
    """Serialize repository records and Git operations; permit nested records writes."""
    held = getattr(_repository_locks, 'held', {})
    if name in held:
        yield
        return
    path = ROOT / 'scratch' / '.locks' / (name + '.lock')
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('a') as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        _repository_locks.held = {**held, name: handle}
        try:
            yield
        finally:
            _repository_locks.held = held


@contextlib.contextmanager
def batch_lock(persona, batch, wait=False):
    # Keep the lock outside scratch/<persona>/<batch>, which finish removes.
    path = ROOT / 'scratch' / persona / '.runtime-locks' / (batch + '.lock')
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('a') as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | (0 if wait else fcntl.LOCK_NB))
        except BlockingIOError:
            raise ValueError('同じ batch が進行中: ' + persona + ' ' + batch) from None
        yield


def runtime_batches(persona):
    active = set()
    for path in (ROOT / 'scratch' / persona / '.runtime-locks').glob('b*.lock'):
        with path.open('a') as handle:
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                active.add(path.stem)
    return active


def job_batches(persona, output):
    prefix = persona.split('-')[0] + '-'
    active = set()
    for line in output.splitlines():
        parts = line.split('\t')
        if len(parts) >= 3 and parts[2] in ('running', 'limit', 'stdin-wait', 'stalled'):
            match = re.fullmatch(re.escape(prefix) + r'(b\d{3,})(?:-r\d+)?', parts[1])
            if match:
                active.add(match[1])
    return active


def admit_batch(batch, jobs='', allow_current=False):
    active = runtime_batches(batch.persona) | job_batches(batch.persona, jobs)
    if batch.batch in active and not allow_current:
        raise ValueError('同じ batch が進行中: ' + batch.batch)
    active.discard(batch.batch)
    maximum = limit('max_batches_per_persona', 'CORPUS_MAX_BATCHES_PER_PERSONA')
    if len(active) >= maximum:
        raise ValueError(f'同じ persona の batch 上限: {maximum}')
    if active:
        ledger = command(['git', 'show', 'HEAD:progress/batches.tsv'], check=False)
        accepted = ledger.returncode == 0 and any(r['persona'] == batch.persona and r['status'] == 'accepted'
                    for r in csv.DictReader(ledger.stdout.splitlines(), delimiter='\t'))
        if not accepted:
            raise ValueError('同じ persona の batch が進行中。並列には受入済み batch が必要')


DEFAULT_LIMITS = {'max_codex': 32, 'max_batches_per_persona': 3}


def limit(key, env):
    """Concurrency limits live in config/limits.json; the environment overrides them for tests."""
    raw = os.environ.get(env)
    if raw is None:
        path = ROOT / 'config' / 'limits.json'
        raw = (json.loads(read(path)) if path.exists() else {}).get(key, DEFAULT_LIMITS[key])
    if not str(raw).isdigit() or int(raw) < 1:
        raise ValueError(f'{key}（config/limits.json）は正の整数')
    return int(raw)


BUILD_WEIGHTS = {'pptx': 3, 'xlsx': 2, 'photo': 2, 'handwriting': 2,
                 'chart': 2, 'diagram': 2, 'screenshot': 2, 'scan': 2,
                 'tex': 1.5, 'docx': 1.5, 'other': 1}


def build_limits():
    path = ROOT / 'config/limits.json'
    cfg = json.loads(read(path)) if path.exists() else {}
    weights = BUILD_WEIGHTS | cfg.get('build_weights', {})
    maximum = cfg.get('max_build_weight', 6)
    for key, value in {'max_build_weight': maximum, **weights}.items():
        if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) or value <= 0:
            raise ValueError(f'{key}（config/limits.json）は正の有限数')
    return weights, maximum


def build_weight(row, weights=None):
    weights = build_limits()[0] if weights is None else weights
    method = row['作り方'].split(':', 1)[0]
    ext = PurePosixPath(row['パス']).suffix.lower().lstrip('.')
    key = method if method in ('photo', 'handwriting', 'chart', 'diagram', 'screenshot', 'scan') else (
        ext if ext in ('pptx', 'xlsx', 'docx') else 'tex' if ext == 'pdf' and method == 'tex' else 'other')
    return weights[key]


def build_groups(rows):
    weights, maximum = build_limits()
    groups, group, total = [], [], 0
    for row in rows:
        weight = build_weight(row, weights)
        if group and total + weight > maximum:
            groups.append(group)
            group, total = [], 0
        group.append(row)
        total += weight
    if group:
        groups.append(group)
    return groups


ROOT_PLACES = set('people sources progress templates personas manifests config ops bin prompts runbooks tests .git'.split())


def root_untracked():
    """Only movable, untracked and nonignored depth-one entries."""
    tracked = {p.split('/')[0] for p in git('ls-files', '-z').split('\0') if p}
    files = [p for p in git('ls-files', '--others', '--exclude-standard', '-z').split('\0') if p]
    candidates = {p.split('/')[0] for p in files}
    # Git does not list empty directories.
    candidates.update(p.name for p in ROOT.iterdir() if p.is_dir() and not p.is_symlink() and not any(p.iterdir()))
    return {name for name in candidates - tracked - ROOT_PLACES
            if command(['git', 'check-ignore', '-q', '--', name], check=False).returncode != 0}


@contextlib.contextmanager
def root_watch(work, stage, execution):
    """Serialize snapshots/moves; remember every overlapping execution across batches."""
    folder = ROOT / 'scratch'
    folder.mkdir(parents=True, exist_ok=True)
    registry = folder / '.root-watch.json'
    identity = str(work.relative_to(ROOT)) + f'/a{execution}'
    label = f'{stage}、{identity}'
    records = []

    @contextlib.contextmanager
    def locked():
        with (folder / '.root-watch.lock').open('a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            active = json.loads(read(registry)) if registry.exists() else {}
            for key, value in list(active.items()):
                try:
                    os.kill(value['pid'], 0)
                except ProcessLookupError:
                    del active[key]
            yield active
            save(registry, active)

    with locked() as active:
        before = root_untracked()
        peers = [value['label'] for value in active.values()]
        for value in active.values():
            value['candidates'].append(label)
        active[identity] = dict(pid=os.getpid(), label=label, candidates=peers + [label])
    try:
        yield records
    finally:
        with locked() as active:
            candidates = active.pop(identity)['candidates']
            for name in sorted(root_untracked() - before):
                source, destination = ROOT / name, work / 'stray' / name
                # Preserve ignored descendants even in an otherwise untracked directory.
                ignored = git('ls-files', '--others', '--ignored', '--exclude-standard', '-z', '--', name).strip('\0')
                try:
                    destination.parent.mkdir(parents=True, exist_ok=True)
                    if source.is_dir() and not source.is_symlink() and ignored:
                        for rel in git('ls-files', '--others', '--exclude-standard', '-z', '--', name).split('\0'):
                            if rel:
                                target = work / 'stray' / rel
                                target.parent.mkdir(parents=True, exist_ok=True)
                                shutil.move(str(ROOT / rel), str(target))
                    else:
                        source.rename(destination)
                except FileNotFoundError:
                    continue  # A peer already moved it.
                records.append(dict(name=name, stage=stage, execution=identity,
                                    candidates=candidates, destination=str(destination.relative_to(ROOT))))


def stray_message(record):
    return (f'repo の直下に作られたファイル：{record["name"]}（{record["stage"]}、{record["execution"]}）'
            + '。候補の実行：' + ' / '.join(record['candidates']) + '。移動先：' + record['destination'])


def slot_limit():
    return limit('max_codex', 'CORPUS_MAX_CODEX')


@contextlib.contextmanager
def codex_slot():
    folder = ROOT / 'scratch/.slots'
    folder.mkdir(parents=True, exist_ok=True)
    handles = [(folder / str(i)).open('a') for i in range(slot_limit())]
    try:
        while True:
            for handle in handles:
                try:
                    fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    continue
                yield handle.fileno()
                return
            time.sleep(.05)
    finally:
        for handle in handles:
            handle.close()


def slot_usage():
    folder = ROOT / 'scratch/.slots'
    folder.mkdir(parents=True, exist_ok=True)
    used = 0
    for i in range(slot_limit()):
        with (folder / str(i)).open('a') as handle:
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                used += 1
    return used


def prerequisites(row):
    return set(filter(None, (x.strip().strip('`') for x in re.split(r'[,、;；\n]+', row.get('先に要るもの', '')))))


def plan_rows(path):
    rows = []
    indices = None
    for index, line in enumerate(read(path).splitlines()):
        if not line.strip().startswith('|'):
            continue
        cells = [c.strip().strip('`') for c in re.split(r'(?<!\\)\|', line.strip().strip('|'))]
        if all(c in cells for c in COLUMNS[:-1]):
            indices = [cells.index(c) if c in cells else None for c in COLUMNS]
            continue
        if indices is None or all(re.fullmatch(r':?-+:?', c) for c in cells):
            continue
        if len(cells) <= max(i for i in indices if i is not None):
            raise ValueError('計画の列が不足')
        row = dict(zip(COLUMNS, (cells[i] if i is not None else '' for i in indices)))
        row['_line'] = index
        row['_content'] = indices[3]
        rows.append(row)
    if indices is None:
        raise ValueError('計画に必要な列: ' + '・'.join(COLUMNS))
    return rows


def mark_discard(path, reasons, marker="破棄"):
    rows = plan_rows(path)
    lines = read(path).splitlines()
    for row in rows:
        if row['パス'] not in reasons:
            continue
        cells = re.split(r'(?<!\\)\|', lines[row['_line']])
        # split retains leading empty cell for the opening pipe.
        old = row['内容']
        reason = re.sub(r'[\t\r\n|]', ' ', reasons[row['パス']]).rstrip('。').replace('。', '；')
        if old.startswith(f'{marker}：{reason}。'):
            continue
        if old.startswith(('破棄：', '成形待ち：')):
            old = old.partition('。')[2]
        cells[row['_content'] + 1] = f' {marker}：{reason}。{old} '
        lines[row['_line']] = '|'.join(cells)
    path.write_text('\n'.join(lines) + '\n')


def missing_explanation(output, rel, rows):
    """Keep the missing row's section, or the whole explanation when it is unlabelled."""
    lines = output.splitlines()
    names = (rel, PurePosixPath(rel).name)
    starts = [i for i, line in enumerate(lines) if any(name in line for name in names)]
    if not starts:
        return ' '.join(output.split())
    sections = []
    others = {r['パス'] for r in rows if r['パス'] != rel}
    for start in starts:
        end = start + 1
        while end < len(lines):
            if lines[end].lstrip().startswith('#') or any(p in lines[end] or PurePosixPath(p).name in lines[end] for p in others):
                break
            end += 1
        sections.extend(lines[start:end])
    return ' '.join(' '.join(sections).split())


class Batch:
    def __init__(self, args):
        self.mutex = threading.RLock()
        self.planning = False
        self.a = args
        self.persona = persona_name(args.persona)
        if not re.fullmatch(r'b\d{3,}', args.batch):
            raise ValueError('batch 名は b001 からの連番')
        self.batch = args.batch
        self.folder = ROOT / 'people' / self.persona
        self.sources = ROOT / 'sources' / self.persona
        self.scratch = ROOT / 'scratch' / self.persona / self.batch
        self.plan = ROOT / 'progress' / self.persona / (self.batch + '.md')
        self.request = self.plan.with_name(self.batch + '.request.md')
        self.result = self.plan.with_name(self.batch + '.result.md')
        self.definition = ROOT / 'personas' / (self.persona + '.md')
        self.templates = ROOT / 'templates' / self.persona / 'README.md'
        self.state_path = self.scratch / 'state.json'
        self.state = json.loads(read(self.state_path)) if self.state_path.exists() else {
            'completed': {}, 'timings': {}, 'status': 'new', 'stage': 'new', 'rebuilds': 0}
        if not self.state_path.exists():
            ledger = ROOT / 'progress/batches.tsv'
            if ledger.exists():
                previous = next((r for r in csv.DictReader(read(ledger).splitlines(), delimiter='\t')
                                 if r['persona'] == self.persona and r['batch'] == self.batch), None)
                if previous:
                    self.state['elapsed_base'] = float(previous['seconds'])
        self.cfg = config(self.definition)

    def store(self):
        with self.mutex:
            save(self.state_path, self.state)

    def scope(self):
        match = re.search(r'範囲\s*[：:]\s*(.+)', read(self.request))
        return match[1].strip() if match else read(self.request).splitlines()[0].lstrip('# ')

    def step(self, key, action, count=0):
        key = getattr(self, 'step_prefix', '') + key
        with self.mutex:
            if key in self.state['completed']:
                return self.state['completed'][key]
            self.state.update(stage=key, status='running', reason='')
            self.state.setdefault('active', {})[key] = count
            self.store()
        print(f'{key} 開始 {count} 件', flush=True)
        started = time.monotonic()
        try:
            value = action()
            with self.mutex:
                self.state['completed'][key] = value
            print(f'{key} 終了 {count} 件', flush=True)
            return value
        finally:
            with self.mutex:
                self.state['timings'][key] = self.state['timings'].get(key, 0) + time.monotonic() - started
                self.state['active'].pop(key, None)
                self.store()

    def parallel_steps(self, tasks):
        if not tasks:
            return []
        with ThreadPoolExecutor(max_workers=len(tasks)) as pool:
            futures = [pool.submit(self.step, key, action, count) for key, action, count in tasks]
            # The executor joins every peer even when a future raises.
            results, errors = [], []
            for future in futures:
                try:
                    results.append(future.result())
                except Exception as exc:
                    errors.append(exc)
            if errors:
                raise errors[0]
            return results

    def shared_hashes(self):
        paths = list(self.templates.parent.rglob('*')) + [self.definition, self.plan.parent / 'facts.md']
        return {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in paths if p.is_file()}

    def codex(self, stage, rows=(), round_number=0, reasons=None, review_output=None, continuation=0, continuation_output=None):
        if self.planning:
            return self._codex(stage, rows, round_number, reasons, review_output, continuation, continuation_output)
        path = ROOT / 'scratch' / self.persona / '.lock'
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open('a') as handle:
            fcntl.flock(handle, fcntl.LOCK_SH)
            before = self.shared_hashes()
            try:
                return self._codex(stage, rows, round_number, reasons, review_output, continuation, continuation_output)
            finally:
                if before != self.shared_hashes():
                    raise ValueError('計画の段階のあとに型・台帳・persona が変更された')

    def _codex(self, stage, rows=(), round_number=0, reasons=None, review_output=None, continuation=0, continuation_output=None):
        logs = self.scratch / 'logs'
        logs.mkdir(parents=True, exist_ok=True)
        with self.mutex:
            number = self.state.get('execution_sequence', 0) + 1
            self.state['execution_sequence'] = number
            self.store()
        work = self.scratch / 'work' / f'{stage}-{number:04}'
        work.mkdir(parents=True, exist_ok=True)
        context = dict(work=str(work.relative_to(ROOT)), render=str((work / 'render').relative_to(ROOT)), stage=stage, persona=self.persona, batch=self.batch,
                       scratch=str(self.scratch.relative_to(ROOT)), plan=str(self.plan.relative_to(ROOT)),
                       rows=list(rows), round=round_number, reasons=reasons or {},
                       continuation=continuation, continuation_output=continuation_output or {},
                       review_output=str(review_output.relative_to(ROOT)) if review_output else '')
        if stage == 'draft':
            context['missing_prerequisites'] = {r['パス']: self.state.get('draft_missing_prerequisites', {}).get(r['パス'], []) for r in rows}
        previous = self.state.get(stage + '_verdicts', {})
        context['previous_verdicts'] = {r['パス']: previous[r['パス']] for r in rows if r['パス'] in previous}
        if stage in ('draft-review', 'build-review'):
            context['reasons'] = {p: v[1] for p, v in context['previous_verdicts'].items() if v[0] == 'reject'}
        references = [
            (self.request, '依頼の範囲と受入条件を確認する'),
            (self.definition, '人物・組織・仕事の流れ・言語と日時の設定を確認する'),
            (self.templates, '使う型・見本と用途を確認する'),
            (self.plan.parent / 'facts.md', '対象の行や依頼に関係する案件・出来事の見出しを検索して読み、共通の事実を照合する'),
            (self.plan, '計画全体の文脈・関連と依存関係を確認する'),
        ]
        if stage == 'plan':
            for other in sorted(self.plan.parent.glob('b*.request.md')):
                other_plan = other.with_name(other.name.replace('.request.md', '.md'))
                if other != self.request and (ROOT / 'scratch' / self.persona / other_plan.stem / 'state.json').exists():
                    references += [(other, '同じ persona の進行中の依頼と範囲を重ねない'),
                                   (other_plan, '同じ persona の進行中の計画とパス・内容を重ねない')]
        # Review reads plans and originals, never producer logs or explanations.
        files = '\n## 読むファイル（パスはリポジトリ直下からの相対パス）\n'
        files += '\n'.join(f'- `{p.relative_to(ROOT)}`：{purpose}。' +
                           ('' if p.exists() else '未作成なら読む必要はありません。')
                           for p, purpose in references) + '\n'
        parts = {'ひな形': read(ROOT / 'prompts' / (stage + '.md')),
                 '参照ファイル': files, '依頼本文': '\n## 依頼\n' + read(self.request)}
        for attempt in range(2):
            if attempt:
                retry_work = work.with_name(work.name + f'-retry{attempt}')
                retry_work.mkdir(parents=True, exist_ok=True)
                context.update(work=str(retry_work.relative_to(ROOT)), render=str((retry_work / 'render').relative_to(ROOT)))
            parts['BATCH_CONTEXT'] = '\nBATCH_CONTEXT\n' + json.dumps(context, ensure_ascii=False) + '\nEND_BATCH_CONTEXT\n'
            sizes = {name: len(value.encode('utf-8')) for name, value in parts.items()}
            total = sum(sizes.values())
            if total > 60 * 1024:
                detail = ', '.join(f'{name}={size} bytes' for name, size in sizes.items())
                raise ValueError(f'指示が 60 KiB を超えています: 合計={total} bytes ({detail})')
            prompt = ''.join(parts.values()).encode('utf-8')
            if review_output is not None:
                review_output.unlink(missing_ok=True)
            base = logs / f'{stage}-{number:04}-a{attempt}'
            output = base.with_suffix('.out.md')
            output.touch()
            model = self.state.get('producer', 'gpt-6.1-terra') if stage in ('draft', 'build') else 'gpt-6.1-sol'
            args = [os.environ.get('CODEX_BIN', 'codex'), 'exec', '-m', model,
                    '-c', 'model_reasoning_effort="medium"', '-s', 'workspace-write',
                    '-c', 'sandbox_workspace_write.network_access=true', '-C', str(ROOT), '-o', str(output), '-']
            with codex_slot() as slot_fd, base.with_suffix('.log').open('w') as log:
                execution_work = ROOT / context['work']
                strays = []
                try:
                    with root_watch(execution_work, stage, attempt) as strays:
                        code = subprocess.run(args, cwd=ROOT, input=prompt, stdout=log, stderr=subprocess.STDOUT, pass_fds=(slot_fd,)).returncode
                finally:
                    with self.mutex:
                        self.state.setdefault('strays', []).extend(strays)
                        self.store()
                    for record in strays:
                        log.write(stray_message(record) + '\n')
                        print(stray_message(record), flush=True)
            if code == 0:
                return read(output) if output.exists() else ''
        tail = '\n'.join(read(base.with_suffix('.log')).splitlines()[-20:])
        self.state['failure_tail'] = tail
        raise ValueError('利用上限' if re.search(r'usage limit|rate limit', tail, re.I) else f'codex exit {code}\n{tail}')

    def timestamp(self, row):
        value = dt.datetime.fromisoformat(row['日付'].replace('Z', '+00:00'))
        if 'T' not in row['日付'] and ' ' not in row['日付']:
            value = value.replace(hour=12)
        if value.tzinfo is None:
            value = value.replace(tzinfo=ZoneInfo(self.cfg.get('timezone', 'UTC')))
        return value

    def validate_plan(self):
        rows = plan_rows(self.plan)
        errors = []
        match = re.search(r'件数の目安\s*[：:]\s*(\d+)', read(self.request))
        if not match:
            raise ValueError('依頼に件数の目安がない')
        target = int(match[1])
        if target <= 0:
            raise ValueError('件数の目安は正の整数')
        if not .5 * target <= len(rows) <= min(1.2 * target, 60):
            errors.append(f'件数 {len(rows)} は目安 {target} の 0.5〜1.2 倍かつ 60 件以下ではない')
        start, end = (dt.date.fromisoformat(x) for x in self.cfg['period'].split('..'))
        seen = set()
        for row in rows:
            rel = row['パス']
            try:
                path = safe_file(self.folder, rel)
                if path.exists() or rel in seen:
                    errors.append('既存または重複パス: ' + rel)
                seen.add(rel)
                ext = path.suffix.lower().lstrip('.')
                if ext not in EXT:
                    errors.append('対象外の拡張子: ' + rel)
                if BAD_PATH.search(rel) or IDENTIFIER.search(path.name):
                    errors.append('制作区分または ID: ' + rel)
                allowed = [m.span() for term in self.cfg.get('allowed_terms', '').split(',') if len(term.split()) >= 2
                           for m in re.finditer(r'(?<!\w)' + r'\s+'.join(re.escape(w) for w in term.split()) + r'(?!\w)', rel, re.I)]
                if any(not any(a <= m.start() and m.end() <= b for a, b in allowed) for m in TRACE.finditer(rel)):
                    errors.append('制作の痕跡: ' + rel)
                value = self.timestamp(row)
                if not start <= value.date() <= end:
                    errors.append('期間外: ' + rel)
                method = row['作り方']
                template = None
                if ext in ('docx', 'xlsx', 'pptx'):
                    template = method
                elif ext == 'pdf':
                    if not method.startswith(('office:', 'tex:', 'scan:')):
                        errors.append('PDF の作り方が不正: ' + rel)
                    elif method.startswith(('office:', 'tex:')):
                        template = method.split(':', 1)[1]
                    elif method.startswith(('scan:office:', 'scan:tex:')):
                        template = method.split(':', 2)[2]
                elif ext in ('png', 'jpg') and method not in ('photo', 'screenshot', 'chart', 'diagram'):
                    errors.append('画像の作り方が不正: ' + rel)
                elif ext not in ('png', 'jpg') and method != 'text':
                    errors.append('作り方は text: ' + rel)
                if template is not None and (not template or not re.search(r'(?<![\w.-])' + re.escape(template) + r'(?![\w.-])', read(self.templates))):
                    errors.append('一覧にないテンプレート: ' + str(template))
                if not row['内容'] or row['内容'].startswith('破棄：'):
                    errors.append('制作前の内容が空か破棄: ' + rel)
            except (ValueError, OSError) as exc:
                errors.append(f'{rel}: {exc}')
        graph = {r['パス']: prerequisites(r) for r in rows}
        for rel, deps in graph.items():
            if deps - graph.keys():
                errors.append('先に要るものは同じ batch の行: ' + rel)
        remaining = dict(graph)
        while remaining:
            ready = {rel for rel, deps in remaining.items() if not deps.intersection(remaining)}
            if not ready:
                errors.append('先に要るものが循環している')
                break
            remaining = {rel: deps for rel, deps in remaining.items() if rel not in ready}
        for other in self.plan.parent.glob('b*.md'):
            if other == self.plan or not re.fullmatch(r'b\d+\.md', other.name):
                continue
            state = ROOT / 'scratch' / self.persona / other.stem / 'state.json'
            if state.exists():
                overlap = graph.keys() & {r['パス'] for r in plan_rows(other)}
                if overlap:
                    errors.append('進行中の batch と重複パス: ' + ', '.join(sorted(overlap)))
        if errors:
            raise ValueError('\n'.join(errors))
        return rows

    def make_plan(self):
        reasons = {}
        for attempt in range(2):
            self.codex('plan', reasons=reasons)
            try:
                return self.validate_plan()
            except (ValueError, OSError, KeyError) as exc:
                reasons = {'計画': str(exc)}
        raise ValueError('計画不合格: ' + reasons['計画'])

    def source(self, relative):
        return safe_file(self.sources, relative + '.md')

    def hashes(self, rows=(), sources=False):
        paths = [self.source(r['パス']) for r in plan_rows(self.plan)] if sources else [safe_file(self.folder, r['パス']) for r in rows]
        return {str(p): hashlib.sha256(p.read_bytes()).hexdigest() if p.is_file() else None
                for p in paths if not sources or p.is_file()}

    def event(self, stage, round_number, criterion, rel, reason):
        item = [dt.datetime.now(dt.timezone.utc).date().isoformat(), self.persona,
                self.batch, stage, str(round_number), criterion or 'other', rel, re.sub(r'[\t\r\n]+', ' ', reason).strip()]
        with self.mutex:
            events = self.state.setdefault('events', [])
            if not any(e[1:] == item[1:] for e in events):
                events.append(item)
            self.store()

    def record_tables(self, status=None, coordinator=None, templates_only=False):
        with repository_lock():
            return self._record_tables(status, coordinator, templates_only)

    def _record_tables(self, status=None, coordinator=None, templates_only=False):
        progress = ROOT / 'progress'
        progress.mkdir(exist_ok=True)
        # Lock the stable directory inode: replacing a TSV must not release its lock.
        with contextlib.ExitStack() as stack:
            fd = os.open(progress, os.O_RDONLY)
            stack.callback(os.close, fd)
            fcntl.flock(fd, fcntl.LOCK_EX)
            def table(name, header):
                path = progress / name
                rows = list(csv.reader(read(path).splitlines(), delimiter='\t')) if path.exists() else []
                if rows and rows[0] != header:
                    raise ValueError('記録の列が不正: ' + name)
                return path, rows[1:] if rows else []
            def write(path, header, rows):
                temp = path.with_suffix('.tmp')
                with temp.open('w') as handle:
                    writer = csv.writer(handle, delimiter='\t', lineterminator='\n')
                    writer.writerow(header)
                    writer.writerows(rows)
                temp.replace(path)
            header = ['date', 'persona', 'batch', 'stage', 'round', 'criterion', 'path', 'reason']
            path, events = table('findings.tsv', header)
            keys = {tuple(e[1:]) for e in events}
            for item in self.state.get('events', []):
                if item[3] == 'check' and item[5] == 'dependency':continue
                if tuple(item[1:]) not in keys:
                    events.append(item)
                    keys.add(tuple(item[1:]))
            write(path, header, events)
            if templates_only:
                return
            header = ['persona', 'batch', 'date', 'planned', 'draft_initial_rejects',
                      'build_initial_rejects', 'final_rejects', 'coordinator_rejects', 'status', 'seconds']
            path, batches = table('batches.tsv', header)
            old = next((r for r in batches if r[:2] == [self.persona, self.batch]), None)
            planned = len(plan_rows(self.plan)) if self.plan.exists() else 0
            def initial(stage):
                return len({e[6] for e in events if e[1:3] == [self.persona, self.batch]
                            and e[3] in stage and e[4] == '0'})
            row = [self.persona, self.batch, old[2] if old else dt.datetime.now(dt.timezone.utc).date().isoformat(),
                   str(planned), old[4] if old and old[8] in ('done', 'accepted', 'discarded') else str(initial(('draft-check', 'draft-review'))),
                   old[5] if old and old[8] in ('done', 'accepted', 'discarded') else str(initial(('check', 'build-review'))), str(sum(r['内容'].startswith(('破棄：', '成形待ち：')) for r in plan_rows(self.plan)) if self.plan.exists() else 0),
                   str(coordinator if coordinator is not None else int(old[7]) if old else 0),
                   status or ('failed' if self.state['status'] == 'failed' else 'done'),
                   f'{self.state.get("elapsed_base", 0) + sum(v for k, v in self.state["timings"].items() if k not in ("draft-complete", "build-complete")):.2f}']
            batches = [row if r[:2] == row[:2] else r for r in batches]
            if old is None:
                batches.append(row)
            write(path, header, batches)

    def review_templates(self, fix=None):
        reasons = {'型': fix} if fix else {}
        for attempt in range(3):
            if reasons:
                self.codex('templates', round_number=attempt, reasons=reasons)
            output = self.scratch / f'templates-review-r{attempt}.tsv'
            paths = list((ROOT / 'templates' / self.persona).rglob('*'))
            before = {str(p): p.read_bytes() for p in paths if p.is_file()}
            inventory = [{'パス': str(p.relative_to(ROOT / 'templates' / self.persona))} for p in paths if p.is_file()]
            self.codex('templates-review', inventory, round_number=attempt, review_output=output)
            after = {str(p): p.read_bytes() for p in (ROOT / 'templates' / self.persona).rglob('*') if p.is_file()}
            if before != after:
                raise ValueError('テンプレートのレビュー中に型が変更された')
            reasons = {}
            entries = list(csv.reader(read(output).splitlines(), delimiter='\t')) if output.exists() else []
            expected = {str(p.relative_to(ROOT / 'templates' / self.persona)) for p in paths if p.is_file()}
            seen = set()
            for entry in entries:
                if len(entry) not in (3, 4) or entry[1] not in ('pass', 'reject'):
                    continue
                rel, verdict = entry[:2]
                if rel not in expected:
                    continue
                if rel in seen:
                    reasons[rel] = '判定が重複'
                seen.add(rel)
                if verdict == 'reject':
                    reasons[rel] = entry[-1] or '理由なし'
            # README is an inventory, not a template. All other files need a verdict.
            for rel in expected - seen - {'README.md'}:
                reasons[rel] = '判定なし'
            if not entries or not expected:
                reasons['README.md'] = '判定なし、または型がない'
            for rel, reason in reasons.items():
                self.event('templates-review', attempt, 'other', rel, reason)
            if not reasons:
                return
        self.record_tables(templates_only=True)
        raise ValueError('テンプレートのレビュー不合格: ' + repr(reasons))

    def dependencies(self, rows):
        candidates = {r['パス'] for r in plan_rows(self.plan)}
        result = {}
        for row in rows:
            rel = row['パス']
            source = self.source(rel)
            cfg = config(source) if source.exists() else {}
            deps = {cfg['derived_from']} if cfg.get('derived_from') else set()
            # 「関連」 lists references in both directions, so it does not define build order.
            text = ''
            attachment_lines = []
            if source.exists():
                in_attachments = False
                for line in read(source).splitlines():
                    declaration = re.match(r'\s*(?:[-*]\s*)?(?:添付(?:ファイル)?|attachments?)\s*[:：](.*)', line, re.I)
                    if declaration:
                        in_attachments = True
                        attachment_lines.append(declaration[1])
                    elif in_attachments and re.match(r'\s*[-*]\s+', line):
                        attachment_lines.append(line)
                    elif line.strip():
                        in_attachments = False
            text += '\n' + '\n'.join(attachment_lines)
            for candidate in candidates:
                if candidate != rel and candidate in text:
                    deps.add(candidate)
            # Also detect absent/previous-batch attachments, not just current rows.
            for line in attachment_lines:
                for match in re.finditer(r'(?:[\w. -]+/)*[^/`\[\],;:：\n]+?\.(?:' + '|'.join(sorted(EXT)) + r')(?=$|[\s`\],;（(])', line):
                    candidate = match[0].strip(' -\"\'')
                    if '/' not in candidate:
                        nearby = (PurePosixPath(rel).parent / candidate).as_posix()
                        matches = [p for p in candidates if PurePosixPath(p).name == candidate]
                        candidate = nearby if nearby in candidates or safe_file(self.folder, nearby).is_file() else matches[0] if len(matches) == 1 else nearby
                    safe_file(self.folder, candidate)
                    deps.add(candidate)
            result[rel] = deps - {rel}
        return result

    def draft_phase(self, rows, all_rows):
        remaining = {r['パス']: r for r in rows}
        failed, history = {}, []
        prefix = getattr(self, 'step_prefix', '')
        wave = 0
        while remaining:
            ready = [r for r in remaining.values() if not prerequisites(r).intersection(remaining)]
            if not ready:
                raise ValueError('先に要るものが循環している')
            targets = ready
            for row in ready:
                missing = sorted(p for p in prerequisites(row) if p in failed or not self.source(p).is_file())
                self.state.setdefault('draft_missing_prerequisites', {})[row['パス']] = missing
            self.step_prefix = prefix + (f'draft-wave{wave}/' if wave or len(ready) != len(rows) else '')
            if targets:
                failed.update(self.phase('draft', targets, all_rows))
                history.extend(self.state.get('draft_history', []))
            for row in ready:
                del remaining[row['パス']]
            wave += 1
        self.step_prefix = prefix
        self.state.update(draft_failures=failed, draft_history=history,
                          draft_pass=len(rows)-len(failed), draft_reject=len(failed))
        self.store()
        return failed

    def build_phase(self, rows, all_rows):
        dependencies = self.dependencies(rows)
        remaining = {r['パス']: r for r in rows}
        failed, history = {}, []
        wave = 0
        base_prefix = getattr(self, 'step_prefix', '')
        while remaining:
            ready = [r for rel, r in remaining.items() if not dependencies[rel].intersection(remaining)]
            if not ready:
                # A cycle cannot be ordered; build what is left together.
                ready = list(remaining.values())
                for rel in remaining:
                    dependencies[rel] -= set(remaining)
            blocked = {}
            targets = []
            for row in ready:
                missing = next((p for p in sorted(dependencies[row['パス']])
                                if p in failed or not safe_file(self.folder, p).is_file()), None)
                if missing:
                    blocked[row['パス']] = f'元のファイル {missing} が未完成。'
                else:
                    targets.append(row)
            # Complete each dependency layer, including its retries and review,
            # before producing anything that consumes it.
            self.step_prefix = base_prefix + (f'build-wave{wave}/' if wave or len(ready) != len(rows) else '')
            if targets:
                failed.update(self.phase('build', targets, all_rows))
                history.extend(self.state.get('build_history', []))
                # Rejected parents must not be consumed in the next layer.
                for row in targets:
                    if row['パス'] in failed:
                        safe_file(self.folder, row['パス']).unlink(missing_ok=True)
            failed.update(blocked)
            for row in ready:
                del remaining[row['パス']]
            wave += 1
        self.step_prefix = base_prefix
        self.state.update(build_failures=failed, build_history=history,
                          build_pass=len(rows)-len(failed), build_reject=len(failed))
        self.store()
        return failed

    def redraft_candidates(self):
        rows = plan_rows(self.plan)
        events = list(self.state.get('events', []))
        ledger = ROOT / 'progress/findings.tsv'
        if ledger.exists():
            events.extend([e[k] for k in ('date', 'persona', 'batch', 'stage', 'round', 'criterion', 'path', 'reason')]
                          for e in csv.DictReader(read(ledger).splitlines(), delimiter='\t')
                          if e['persona'] == self.persona and e['batch'] == self.batch)
        selected, unknown = [], []
        for row in rows:
            if self.state.get('redraft_active') and row['パス'] in self.state.get('redraft_paths', []):
                selected.append(row)
                continue
            if not row['内容'].startswith('破棄：'):
                continue
            rel = row['パス']
            reason = row['内容'].partition('。')[0].removeprefix('破棄：')
            related = [e for e in events if e[6] == rel]
            if reason == '統括の抜き取りで不合格' or any(e[3] == 'coordinator' for e in related):
                continue
            if (rel in self.state.get('draft_failures', {}) or reason == '先に要る原稿が不合格'
                    or any(e[3] in ('draft-check', 'draft-review') and
                           e[7].rstrip('。').replace('。', '；') == reason for e in related)):
                selected.append(row)
            else:
                unknown.append(rel)
        return selected, unknown

    def redraft(self):
        pending, unknown = self.redraft_candidates()
        for rel in unknown:
            print('原稿段階の破棄か判断できないため対象外: ' + rel, flush=True)
        if not pending:
            return
        self.protected(pending)
        paths = {r['パス'] for r in pending}
        if not self.state.get('redraft_active'):
            self.state['redraft_previous_draft_failures'] = {p: why for p, why in self.state.get('draft_failures', {}).items() if p not in paths}
            self.state['redraft_previous_failures'] = {p: why for p, why in self.state.get('failures', {}).items() if p not in paths}
        self.state['redraft_paths'] = sorted(paths)
        # Retain this scope for the coordinator's later acceptance, like --rebuild.
        self.state['rebuild_paths'] = sorted(set(self.state.get('rebuild_paths', [])) | paths)
        active = self.state.get('redraft_active', False)
        generation = self.state.get('redraft_generation', 0) + (not active)
        self.state.update(redraft_generation=generation, redraft_active=True)
        self.step_prefix = f'redraft{generation}/'
        self.store()
        lines = read(self.plan).splitlines()
        for row in pending:
            cells = re.split(r'(?<!\\)\|', lines[row['_line']])
            if row['内容'].startswith('破棄：'):
                row['内容'] = row['内容'].partition('。')[2]
            cells[row['_content']+1] = ' ' + row['内容'] + ' '
            lines[row['_line']] = '|'.join(cells)
        self.plan.write_text('\n'.join(lines)+'\n')
        self.state['draft_failures'] = {p: why for p, why in self.state.get('draft_failures', {}).items() if p not in paths}
        self.state['failures'] = {p: why for p, why in self.state.get('failures', {}).items() if p not in paths}
        self.state.update(status='running', stage='redraft')
        self.store()
        rows = plan_rows(self.plan)
        previous_draft = self.state['redraft_previous_draft_failures']
        draft_failures = self.step('draft-complete', lambda: self.draft_phase(pending, rows))
        self.state['draft_failures'] = {**previous_draft, **draft_failures}
        self.discard_rows(draft_failures)
        build_rows = [r for r in pending if r['パス'] not in draft_failures]
        build_failures = self.step('build-complete', lambda: self.build_phase(build_rows, rows))
        failures = {**self.state['redraft_previous_failures'], **draft_failures, **build_failures}
        self.state.update(failures=failures, count=sum(not r['内容'].startswith('破棄：') and r['パス'] not in failures for r in plan_rows(self.plan)))
        self.write_report(plan_rows(self.plan), failures, mutation_paths=paths)
        self.final_check()
        self.state.update(status='done', stage='done', reason='', redraft_active=False)
        self.store()

    def rebuild_pending(self):
        rows = plan_rows(self.plan)
        pending = [r for r in rows if r['内容'].startswith('成形待ち：')]
        if not pending:
            return
        self.protected(pending, artifacts_only=True)
        self.state['rebuild_paths'] = [r['パス'] for r in pending]
        for row in pending:
            if not self.source(row['パス']).is_file():
                raise ValueError('成形待ちの原稿がない: ' + row['パス'])
        generation = self.state.get('rebuild_generation', 0) + (self.state.get('status') in ('done', 'accepted'))
        generation = max(1, generation)
        self.state['rebuild_generation'] = generation
        self.step_prefix = f'rebuild{generation}/'
        self.state.update(status='running', stage='rebuild')
        self.store()
        # Expose pending targets to bin/check while retaining their saved source.
        lines = read(self.plan).splitlines()
        for row in pending:
            cells = re.split(r'(?<!\\)\|', lines[row['_line']])
            cells[row['_content']+1] = ' ' + row['内容'].partition('。')[2] + ' '
            lines[row['_line']] = '|'.join(cells)
        self.plan.write_text('\n'.join(lines)+'\n')
        try:
            failures = self.build_phase(pending, rows)
            previous = {p: reason for p, reason in self.state.get('failures', {}).items()
                        if p not in {r['パス'] for r in pending}}
            self.state['failures'] = {**previous, **failures}
            self.state['count'] = sum(not r['内容'].startswith('破棄：') and r['パス'] not in self.state['failures'] for r in rows)
            self.write_report(rows, self.state['failures'])
            self.final_check()
        except Exception:
            mark_discard(self.plan, {r['パス']: '再成形が未完了' for r in pending}, '成形待ち')
            raise
        self.state.update(status='done', stage='done')
        self.store()

    def draft_check(self, rows):
        failures, comparisons, derived = {}, [], {}
        related = set()
        for plan in self.plan.parent.glob('b*.md'):
            if not re.fullmatch(r'b\d+\.md', plan.name):
                continue
            for row in plan_rows(plan):
                refs = prerequisites(row) | set(filter(None, (v.strip().strip('`') for v in re.split(r'[,、;；\n]+', row.get('関連', '')))))
                related.update(frozenset((row['パス'], ref)) for ref in refs)
        expected = {self.source(r['パス']): r for r in rows}
        for path in sorted(set(self.sources.rglob('*.md')) | set(expected)):
            row = expected.get(path)
            rel = row['パス'] if row else str(path.relative_to(self.sources)).removesuffix('.md')
            try:
                text = read(path)
                match = re.match(r'\A---\n(.*?)\n---(?:\n|$)(.*)\Z', text, re.S)
                if not match:
                    raise ValueError('frontmatter がない')
                metadata = config(path)
                body = match[2].strip()
                if metadata.get('path') != rel or row and metadata.get('kind') != row['作り方']:
                    raise ValueError('frontmatter path/kind が計画と違う')
                if not body:
                    raise ValueError('本文が空')
                allowed = [m.span() for term in self.cfg.get('allowed_terms', '').split(',') if len(term.split()) >= 2
                           for m in re.finditer(r'(?<!\w)' + r'\s+'.join(re.escape(w) for w in term.split()) + r'(?!\w)', body, re.I)]
                if any(not any(a <= m.start() and m.end() <= b for a, b in allowed) for m in TRACE.finditer(body)):
                    raise ValueError('制作の痕跡')
                if metadata.get('derived_from'):
                    missing = self.state.get('draft_missing_prerequisites', {}).get(rel, [])
                    if not (self.sources / (metadata['derived_from'] + '.md')).is_file() and metadata['derived_from'] not in missing:
                        raise ValueError('derived_from の元の原稿がない（元が成果物でないなら derived_from を空にして本文に全文を書く）: ' + metadata['derived_from'])
                    derived[rel] = metadata['derived_from']
                text = re.sub(r'\d+', '0', body.casefold())
                words = re.findall(r'[\u3040-\u30ff\u3400-\u9fff]|[^\W_\u3040-\u30ff\u3400-\u9fff]+', text)
                grams = frozenset(int.from_bytes(hashlib.blake2b(' '.join(words[i:i+5]).encode(), digest_size=8).digest(), 'big') for i in range(len(words)-4))
                # A derived draft holds only its differences (often just "none"), so its body says nothing about duplication.
                if not metadata.get('derived_from'):
                    comparisons.append((rel, hashlib.sha256(body.encode()).digest(), grams))
            except (OSError, ValueError, UnicodeError) as exc:
                if row:
                    failures[rel] = str(exc)
        # Exact .8 Jaccard prefix join with the same five-word normalization as bin/check.
        hashes, groups = defaultdict(list), defaultdict(list)
        known = {r['パス'] for r in rows}
        def reject(paths, reason):
            for rel in paths:
                if rel in known:
                    failures.setdefault(rel, 'duplicate: ' + reason)
        def reject_pairs(left, right, reason, exact=False):
            for a in left:
                for b in right:
                    if a != b and (exact or derived.get(a) != b and derived.get(b) != a and frozenset((a, b)) not in related):
                        reject((a,), reason + ': ' + b)
                        reject((b,), reason + ': ' + a)
        for rel, digest, grams in comparisons:
            hashes[digest].append(rel)
            if grams:
                groups[grams].append(rel)
        for paths in hashes.values():
            if len(paths) > 1:
                reject_pairs(paths, paths, 'identical bytes', exact=True)
        for paths in groups.values():
            if len(paths) > 1:
                reject_pairs(paths, paths, 'identical normalized shingles')
        frequency = Counter(g for grams in groups for g in grams)
        index = defaultdict(list)
        for grams, paths in sorted(groups.items(), key=lambda x: len(x[0])):
            n = len(grams)
            prefix = sorted(grams, key=lambda g: (frequency[g], g))[:n-math.ceil(.8*n)+1]
            candidates = {other for g in prefix for other in index[g] if 5*len(other) >= 4*n}
            for other in candidates:
                intersection = len(grams & other)
                if 5*intersection >= 4*(n+len(other)-intersection):
                    reject_pairs(paths, groups[other], 'normalized 5-word Jaccard >= 0.8')
            for g in prefix:
                index[g].append(grams)
        return failures

    def check(self, round_number, rows):
        report = self.scratch / (getattr(self, 'step_prefix', '').replace('/', '-') + f'check-r{round_number}.tsv')
        report.unlink(missing_ok=True)
        result = command([ROOT / 'bin/check', self.persona, '--batch', self.batch, '--report', report], check=False)
        (self.scratch / 'logs' / (getattr(self, 'step_prefix', '').replace('/', '-') + f'check-r{round_number}.log')).write_text(result.stdout)
        if not report.exists():
            raise ValueError('bin/check が報告を書かなかった: ' + result.stdout[-2000:])
        failures = {}
        for parts in csv.reader(read(report).splitlines(), delimiter='\t'):
            if len(parts) != 4 or parts[0] != self.persona:
                raise ValueError('bin/check の報告形式が不正')
            if parts[1] in {r['パス'] for r in rows} and not (parts[2] == 'plan' and parts[3] == 'planned file missing'):
                self.event('check', round_number, parts[2], parts[1], parts[3])
            failures[parts[1]] = failures.get(parts[1], '') + f'{parts[2]}: {parts[3]} '
        known = {r['パス'] for r in rows}
        outside = failures.keys() - known
        planned = {r['パス'] for r in plan_rows(self.plan)}
        if outside - planned:
            raise ValueError('batch 外の検査不合格: ' + repr(outside - planned))
        failures = {p: why for p, why in failures.items() if p in known}
        if result.returncode and not failures and not outside:
            raise ValueError('bin/check 未完了（検査不能または OCR 未実行）: ' + result.stdout[-2000:])
        return failures

    def review(self, stage, rows, all_rows, round_number, group):
        output = self.scratch / (getattr(self, 'step_prefix', '').replace('/', '-') + f'{stage}-r{round_number}-g{group}.tsv')
        output.unlink(missing_ok=True)
        sources, artifacts = self.hashes(sources=True), self.hashes(all_rows)
        try:
            notes = self.codex(stage, rows, round_number, review_output=output)
        finally:
            if sources != self.hashes(sources=True) or artifacts != self.hashes(all_rows):
                raise ValueError('レビュー中に原稿または成果物が変更された')
        with self.mutex:
            self.state.setdefault(stage + '_notes', []).append(f'{getattr(self, "step_prefix", "")}round {round_number} / 組 {group + 1}\n\n{notes}')
        verdicts = {}
        for parts in csv.reader(read(output).splitlines() if output.exists() else [], delimiter='\t'):
            if len(parts) not in (3, 4) or parts[1] not in ('pass', 'reject'):
                continue
            rel, verdict = parts[:2]
            criterion, reason = (parts[2], parts[3]) if len(parts) == 4 else ('other', parts[2])
            valid = {f'{"D" if stage == "draft-review" else "V"}{i}' for i in range(1, 11 if stage == 'draft-review' else 7)}
            criterion = criterion if criterion in valid else 'other'
            verdicts[rel] = ['reject', '判定が重複', 'other'] if rel in verdicts else [verdict, reason or '理由なし', criterion if verdict == 'reject' else '']
        result = {r['パス']: verdicts.get(r['パス'], ['reject', '判定なし', 'other']) for r in rows}
        for rel, (verdict, reason, criterion) in result.items():
            if verdict == 'reject':
                self.event(stage, round_number, criterion, rel, reason)
        with self.mutex:
            self.state.setdefault(stage + '_verdicts', {}).update(result)
        return result

    def phase(self, stage, rows, all_rows):
        failures, history = {}, []
        for round_number in range(3):
            targets = [r for r in rows if not round_number or r['パス'] in failures]
            if not targets:
                break
            if round_number:
                def remove():
                    self.protected(targets, artifacts_only=stage == 'build')
                    for row in targets:
                        path = self.source(row['パス']) if stage == 'draft' else safe_file(self.folder, row['パス'])
                        path.unlink(missing_ok=True)
                self.step(f'{stage}-delete-r{round_number}', remove, len(targets))
            production_tasks = []
            groups = build_groups(targets) if stage == 'build' else [targets[i:i+10] for i in range(0, len(targets), 10)]
            for i, group in enumerate(groups):
                key = f'{stage}-r{round_number}-g{i}'
                if stage == 'build':
                    with self.mutex:
                        self.state.setdefault('build_groups', {})[getattr(self, 'step_prefix', '') + key] = [r['パス'] for r in group]
                        self.store()
                def produce(group=group, key=key):
                    attempted = self.state.setdefault('attempted', [])
                    attempt_key = getattr(self, 'step_prefix', '') + key
                    pending = group
                    if attempt_key in attempted:
                        pending = [r for r in group if not (self.source(r['パス']) if stage == 'draft' else safe_file(self.folder, r['パス'])).is_file()]
                    else:
                        attempted.append(attempt_key)
                        self.store()
                    if stage == 'build' and round_number == 0 and (self.a.review_again or getattr(self.a, 'draft_review_again', False)):
                        pending = [r for r in pending if not safe_file(self.folder, r['パス']).is_file()]
                    before = self.hashes(sources=True)
                    try:
                        if stage == 'draft':
                            if pending:
                                self.codex(stage, pending, round_number, failures)
                        else:
                            # Persist successful invocations so resume cannot replenish the continuation budget.
                            with self.mutex:
                                run = self.state.setdefault('build_runs', {}).setdefault(attempt_key, {'completed': 0, 'output': {}})
                            for execution in range(run['completed'], 3):
                                if not pending:
                                    break
                                if execution:
                                    with self.mutex:
                                        for row in pending:
                                            used = self.state.setdefault('build_continuations', {}).setdefault(row['パス'], [])
                                            marker = f'{attempt_key}/continue{execution}'
                                            if marker not in used:
                                                used.append(marker)
                                        self.store()
                                options = dict(continuation=execution, continuation_output={r['パス']: run['output'].get(r['パス'], '') for r in pending}) if execution else {}
                                output = self.codex(stage, pending, round_number, failures, **options)
                                pending = [r for r in pending if not safe_file(self.folder, r['パス']).is_file()]
                                with self.mutex:
                                    run['completed'] = execution + 1
                                    run['output'] = {r['パス']: missing_explanation(output, r['パス'], group) for r in pending}
                                    self.state.setdefault('build_missing_output', {}).update(run['output'])
                                    self.store()
                    finally:
                        if stage == 'build' and before != self.hashes(sources=True):
                            raise ValueError('成形中に原稿が変更された')
                production_tasks.append((key, produce, len(group)))
            self.parallel_steps(production_tasks)
            if stage == 'build':
                def dates():
                    errors = {}
                    for row in targets:
                        path = safe_file(self.folder, row['パス'])
                        if path.exists():
                            source_config = config(self.source(row['パス']))
                            args = [ROOT / 'bin/stamp', path, '--author', source_config.get('author', ''),
                                    '--date', row['日付'], '--timezone', self.cfg.get('timezone', 'UTC')]
                            for key, flag in [('modified_by', '--modified-by'), ('created', '--created'), ('device', '--device')]:
                                if source_config.get(key):args += [flag, source_config[key].strip("\"'")]
                            if path.suffix.lower() == '.pdf' and row['作り方'].startswith('office:'):
                                parent = config(self.source(row['パス'])).get('derived_from', '')
                                app = {'.xlsx': 'Excel', '.pptx': 'PowerPoint'}.get(Path(parent or row['作り方']).suffix.lower(), 'Word')
                                args += ['--producer', f'Microsoft® {app} for Microsoft 365']
                            criterion = 'metadata'
                            try:
                                if path.suffix.lower() == '.xlsx':
                                    with zipfile.ZipFile(path) as archive:
                                        has_formula = any(any(n.tag.rsplit('}', 1)[-1] == 'f' for n in ET.fromstring(archive.read(name)).iter())
                                                          for name in archive.namelist() if name.startswith('xl/worksheets/') and name.endswith('.xml'))
                                    if has_formula:
                                        criterion = 'formula'
                                        command([ROOT / 'bin/recalc', path])
                                criterion = 'metadata'
                                command(args)
                            except (ValueError, OSError, zipfile.BadZipFile, ET.ParseError) as exc:
                                errors[row['パス']] = criterion + ': ' + str(exc)
                                self.event('check', round_number, criterion, row['パス'], str(exc))
                                continue
                            stamp = self.timestamp(row).timestamp()
                            os.utime(path, (stamp, stamp))
                    return errors
                stamp_failures = self.step(f'dates-r{round_number}', dates, len(targets)) or {}
            automatic = self.step(f'{stage}-check-r{round_number}',
                                  lambda: self.draft_check(rows) if stage == 'draft' else self.check(round_number, rows), len(targets))
            if stage == 'draft':
                for rel, reason in automatic.items():
                    self.event('draft-check', round_number, 'duplicate' if reason.startswith('duplicate:') else 'frontmatter' if 'frontmatter' in reason else 'trace' if reason == '制作の痕跡' else 'derived_from' if reason.startswith('derived_from') else 'source', rel, reason)
            failures = dict(automatic)
            if stage == 'build':
                failures.update(stamp_failures)
            review_rows = [r for r in targets if r['パス'] not in failures]
            verdicts, review_stage = {}, stage + '-review'
            review_tasks = []
            for i in range(0, len(review_rows), 10):
                group = review_rows[i:i+10]
                review_tasks.append((f'{review_stage}-r{round_number}-g{i//10}',
                                     lambda group=group, i=i: self.review(review_stage, group, all_rows, round_number, i//10), len(group)))
            for result in self.parallel_steps(review_tasks):
                verdicts.update(result)
            report_stage = 'review' if stage == 'build' else review_stage
            with (self.scratch / (getattr(self, 'step_prefix', '').replace('/', '-') + f'{report_stage}-r{round_number}.tsv')).open('w') as handle:
                csv.writer(handle, delimiter='\t', lineterminator='\n').writerows([rel, v[0], v[2], v[1]] for rel, v in verdicts.items())
            failures.update({rel: v[1] for rel, v in verdicts.items() if v[0] != 'pass'})
            history.append({'round': round_number, 'failures': failures.copy()})
            self.state.update({stage + '_failures': failures, stage + '_history': history,
                               stage + '_retries': round_number, stage + '_pass': len(rows)-len(failures), stage + '_reject': len(failures)})
            if stage == 'build':
                self.state['rebuilds'] = round_number
            self.store()
            if not failures:
                break
        return failures

    def run(self):
        if not self.request.is_file():
            raise ValueError('依頼なし: ' + str(self.request))
        again = self.a.review_again or getattr(self.a, 'draft_review_again', False)
        rebuild = getattr(self.a, 'rebuild', False)
        redraft = getattr(self.a, 'redraft', False)
        if self.state['status'] in ('done', 'accepted') and not again and not rebuild and not redraft:
            print(f'done 終了 {self.state.get("count", 0)} 件', flush=True)
            return
        self.state['active'] = {}
        self.state['producer'] = self.a.producer or self.state.get('producer', 'gpt-6.1-terra')
        self.scratch.mkdir(parents=True, exist_ok=True)
        (self.scratch / 'logs').mkdir(exist_ok=True)
        try:
            if redraft:
                self.redraft()
                return
            if again:
                def keep(key):
                    if key in ('templates', 'templates-reviewed', 'plan'):
                        return True
                    if getattr(self.a, 'draft_review_again', False):
                        return bool(re.fullmatch(r'draft-r0-g\d+', key.rsplit('/', 1)[-1]))
                    leaf = key.rsplit('/', 1)[-1]
                    return key.startswith('draft-') or leaf.startswith(('build-r0-', 'dates-r0'))
                self.state['completed'] = {k: v for k, v in self.state['completed'].items() if keep(k)}
                self.state['attempted'] = [k for k in self.state.get('attempted', []) if keep(k)]
                for stage in ('draft-review', 'build-review') if getattr(self.a, 'draft_review_again', False) else ('build-review',):
                    self.state[stage + '_notes'] = []
                self.store()
            if rebuild:
                self.rebuild_pending()
                return
            with persona_lock(self.persona, wait=True):
                self.planning = True
                try:
                    self.step('templates', lambda: self.codex('templates') if not self.templates.exists() else '')
                    self.step('templates-reviewed', self.review_templates)
                    template_hashes = {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in self.templates.parent.rglob('*') if p.is_file()}
                    rows = self.step('plan', self.make_plan)
                    if template_hashes != {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in self.templates.parent.rglob('*') if p.is_file()}:
                        self.step('plan-templates-reviewed', self.review_templates)
                finally:
                    self.planning = False
            current = {r['パス']: r for r in plan_rows(self.plan)}
            if set(current) != {r['パス'] for r in rows}:
                raise ValueError('検査済み計画のパスが変更された')
            for row in rows:
                new = current[row['パス']]
                if any(new.get(c, '') != row.get(c, '') for c in COLUMNS if c != '内容') or (new['内容'] != row['内容'] and not new['内容'].startswith(('破棄：', '成形待ち：'))):
                    raise ValueError('検査済み計画が変更された: ' + row['パス'])
            rows = [current[r['パス']] for r in rows if not again or not current[r['パス']]['内容'].startswith(('破棄：', '成形待ち：'))]
            if self.a.plan_only:
                self.state.update(status='planned', stage='plan', count=len(rows))
                self.store()
                return
            draft_failures = self.step('draft-complete', lambda: self.draft_phase(rows, rows))
            draft_failures = {rel: reason for rel, reason in draft_failures.items() if rel in {r['パス'] for r in rows}}
            build_rows = [r for r in rows if r['パス'] not in draft_failures]
            self.step('draft-discard', lambda: self.discard_rows(draft_failures), len(draft_failures))
            build_failures = self.step('build-complete', lambda: self.build_phase(build_rows, rows))
            pending_before = {r['パス']: r['内容'].removeprefix('成形待ち：').partition('。')[0]
                              for r in plan_rows(self.plan) if r['内容'].startswith('成形待ち：')}
            failures = {**pending_before, **draft_failures, **build_failures}
            self.state.update(failures=failures, count=sum(not r['内容'].startswith('破棄：') and r['パス'] not in failures for r in plan_rows(self.plan)))
            self.step('report', lambda: self.write_report(rows, failures), len(rows)-len(failures))
            self.step('final-check', self.final_check, len(rows)-len(failures))
            self.write_report(rows, failures)
            self.state.update(status='done', stage='done', reason='')
            self.store()
        except (ValueError, OSError, KeyError) as exc:
            self.state.update(status='failed', reason=str(exc))
            self.store()
            self.record_tables()
            raise

    def discard_rows(self, failures):
        self.protected([{'パス': rel} for rel in failures])
        for rel in failures:
            safe_file(self.folder, rel).unlink(missing_ok=True)
            self.source(rel).unlink(missing_ok=True)
        mark_discard(self.plan, failures)

    def final_check(self):
        result = command([ROOT / 'bin/check', self.persona, '--batch', self.batch], check=False)
        (self.scratch / 'logs/final-check.log').write_text(result.stdout)
        if result.returncode:
            raise ValueError('最終検査不合格: ' + result.stdout[-2000:])

    def write_report(self, rows, failures, mutation_paths=None):
        draft_failures = self.state.get('draft_failures', {})
        self.discard_rows({p: why for p, why in failures.items() if p in draft_failures and (mutation_paths is None or p in mutation_paths)})
        waiting = {p: why for p, why in failures.items() if p not in draft_failures}
        for rel, reason in list(waiting.items()):
            if 'plan: planned file missing' in reason:
                output = self.state.get('build_missing_output', {}).get(rel, '')
                # Unlabelled producer prose is retained in full rather than guessing a reason.
                excerpt = ' '.join(output.split()) or '成形の最終出力に作れなかった理由の記載なし'
                waiting[rel] = reason.partition('。成形の最終出力：')[0].strip() + '。成形の最終出力：' + excerpt
                failures[rel] = waiting[rel]
                self.event('check', 2, 'plan', rel, waiting[rel])
        changed_waiting = {p: why for p, why in waiting.items() if mutation_paths is None or p in mutation_paths}
        self.protected([{'パス': p} for p in changed_waiting], artifacts_only=True)
        for rel in changed_waiting:
            safe_file(self.folder, rel).unlink(missing_ok=True)
        mark_discard(self.plan, changed_waiting, '成形待ち')
        self.state['pending'] = len(waiting)
        self.record_tables()
        discarded = {r['パス']: r['内容'].removeprefix('破棄：').partition('。')[0]
                     for r in plan_rows(self.plan) if r['内容'].startswith('破棄：')}
        discarded.update({p: why for p, why in failures.items() if p in draft_failures})
        counts = Counter(Path(r['パス']).suffix for r in rows if r['パス'] not in failures and not r['内容'].startswith('破棄：'))
        text = f'# {self.persona} {self.batch} の結果\n\n状態：結果待ち\n\n## 依頼との対応\n\n{read(self.request)}\n'
        text += f'\n制作：{sum(counts.values())} 件\n\n' + '\n'.join(f'- {ext}: {n} 件' for ext, n in sorted(counts.items()))
        text += '\n\n## 成形待ち\n\n' + ('\n'.join(f'- {p}: {why}' for p, why in waiting.items()) or 'なし')
        text += '\n\n## 続きを使った行\n\n' + ('\n'.join(f'- {rel}: ' + ', '.join(runs) for rel, runs in sorted(self.state.get('build_continuations', {}).items())) or 'なし')
        text += '\n\n## repo の直下に作られたファイル\n\n' + ('\n'.join('- ' + stray_message(record) for record in self.state.get('strays', [])) or 'なし')
        text += '\n\n## 破棄した行と理由\n\n' + ('\n'.join(f'- {rel}: {why}' for rel, why in discarded.items()) or 'なし')
        text += '\n\n## 先に要る原稿が欠けたまま書いた行\n\n' + ('\n'.join(f'- {rel}: ' + ', '.join(missing) for rel, missing in sorted(self.state.get('draft_missing_prerequisites', {}).items()) if missing) or 'なし')
        for stage, label in (('draft', '原稿'), ('build', '成形')):
            text += f'\n\n## {label}の検査とレビュー\n\n合格：{self.state.get(stage + "_pass", 0)} 件、不合格：{self.state.get(stage + "_reject", 0)} 件、作り直し：{self.state.get(stage + "_retries", 0)} 回\n'
            elapsed = self.state['timings'].get(stage + '-complete', 0)
            text += f'\n{label}の所要時間：{elapsed:.2f} 秒\n'
            for entry in self.state.get(stage + '_history', []):
                text += f'\nround {entry["round"]}: 不合格 {len(entry["failures"])} 件\n'
                text += '\n'.join(f'- {rel}: {reason}' for rel, reason in entry['failures'].items()) + '\n'
            text += '\nレビュー役の所見：\n\n' + ('\n\n'.join(self.state.get(stage + '-review_notes', [])) or '対象なし')
        text += f'\n\nレンダリング：{self.scratch.relative_to(ROOT)}/work/*/render/\n\n## 各段階の所要時間\n\n'
        text += '\n'.join(f'- {key}: {value:.2f} 秒' for key, value in self.state['timings'].items())
        self.result.write_text(text + '\n')

    def protected(self, rows, artifacts_only=False):
        head = command(['git', 'ls-tree', '-rz', '--name-only', 'HEAD'], check=False)
        tracked = set(head.stdout.split('\0'))
        for row in rows:
            paths = [safe_file(self.folder, row['パス'])]
            if not artifacts_only:
                paths.append(self.source(row['パス']))
            if any(str(path.relative_to(ROOT)) in tracked for path in paths):
                raise ValueError('受入済みのファイルには操作しない: ' + row['パス'])

    def finish(self, discard=False):
        with batch_lock(self.persona, self.batch), persona_lock(self.persona, wait=True, shared=True), repository_lock():
            return self._finish(discard)

    def _finish(self, discard=False):
        rows = plan_rows(self.plan)
        rebuilding = self.state.get('rebuild_paths')
        self.protected([r for r in rows if not rebuilding or r['パス'] in rebuilding], artifacts_only=bool(rebuilding))
        if rebuilding and discard:
            raise ValueError('再成形済み batch の一括破棄は受入済みのファイルに影響する')
        progress = [p for p in self.plan.parent.glob(self.batch + '.*') if p.is_file()]
        paths = [str(p.relative_to(ROOT)) for p in progress] + ['progress/findings.tsv', 'progress/batches.tsv']
        active = [r for r in rows if not r['内容'].startswith('破棄：')]
        if not discard:
            if self.state.get('status') != 'done':
                raise ValueError('制作とレビューが完了していない')
            paths += [str(safe_file(self.folder, r['パス']).relative_to(ROOT)) for r in active if not r['内容'].startswith('成形待ち：')]
            paths += [str(self.source(r['パス']).relative_to(ROOT)) for r in active]
            paths += [f'manifests/{self.persona}.tsv', f'personas/{self.persona}.md', f'progress/{self.persona}/facts.md']
            template_root = ROOT / 'templates' / self.persona
            paths += [str(p.relative_to(ROOT)) for p in template_root.rglob('*') if p.is_file()]
            paths += [p for p in git('ls-files', '-z', '--', f'templates/{self.persona}').split('\0') if p]
        staged = set(filter(None, git('diff', '--cached', '--name-only', '-z').split('\0')))
        if staged - set(paths):
            raise ValueError('関係ないファイルが stage されている: ' + ', '.join(sorted(staged - set(paths))))
        drops = {r['パス']: self.a.reason for r in rows} if discard else {
            p: '統括の抜き取りで不合格' for p in self.a.drop}
        if drops.keys() - (set(rebuilding) if rebuilding else {r['パス'] for r in rows}):
            raise ValueError('--drop はこの batch の相対パスを指定する')
        # All preconditions above precede any mutation, including drops.
        for rel in drops:
            safe_file(self.folder, rel).unlink(missing_ok=True)
            self.source(rel).unlink(missing_ok=True)
        mark_discard(self.plan, drops)
        for rel, reason in drops.items():
            self.event('coordinator', 0, 'other', rel, reason)
        if not discard:
            command([ROOT / 'bin/check', self.persona, '--batch', self.batch])
            includes = [r['パス'] for r in plan_rows(self.plan)
                        if not r['内容'].startswith(('破棄：', '成形待ち：'))]
            command([ROOT / 'bin/manifest', self.persona,
                     *[arg for rel in includes for arg in ('--include', rel)]])
        self.record_tables('discarded' if discard else 'accepted', len(drops))
        marker = '破棄' if discard else '受入済み'
        if self.result.exists():
            text = re.sub(r'^状態：.*$', '状態：' + marker, read(self.result), flags=re.M)
            if '状態：' not in text:
                text += '\n状態：' + marker + '\n'
            if drops:
                text += '\n統括の判断：\n' + '\n'.join(f'- {p}: {r}' for p, r in drops.items()) + '\n'
            self.result.write_text(text)
        else:
            self.result.write_text(f'# {self.persona} {self.batch}\n\n状態：{marker}\n\n理由：{self.a.reason if discard else ""}\n')
            paths.append(str(self.result.relative_to(ROOT)))
        # Drop untracked paths that no longer exist, keep tracked deletions.
        tracked = set(git('ls-files', '-z').split('\0'))
        paths = sorted(set(p for p in paths if (ROOT / p).exists() or p in tracked))
        git('add', '--', *paths)
        if set(filter(None, git('diff', '--cached', '--name-only', '-z').split('\0'))) - set(paths):
            raise ValueError('stage の範囲が変わった')
        count = sum(safe_file(self.folder, r['パス']).is_file() for r in active)
        message = (f'Discard {self.persona} {self.batch}: {self.a.reason}' if discard else
                   f'Accept {self.persona} {self.batch}: {self.scope()} ({count} files)')
        git('commit', '-m', message)
        self.state.update(status='discarded' if discard else 'accepted', stage='finished')
        self.store()
        if discard or not any(r['内容'].startswith('成形待ち：') for r in plan_rows(self.plan)):
            shutil.rmtree(self.scratch, ignore_errors=True)
        print(f'{marker}: {self.persona} {self.batch} {count} 件')


def job_tool():
    return str(ROOT / 'ops/bin/codex-job')


def launch(batch):
    with repository_lock('admission'):
        return _launch(batch)


def _launch(batch):
    if not batch.request.is_file():
        raise ValueError('依頼なし: ' + str(batch.request))
    if shutil.disk_usage(ROOT).free < 30_000_000_000:
        raise ValueError('空き容量が 30,000,000,000 バイト未満')
    result = command([job_tool(), 'status', '--repo', 'personaCorpus'])
    admit_batch(batch, result.stdout)
    home = Path(os.environ.get('AGENT_OPS_HOME', ROOT / 'ops'))
    names = {p.name for p in (home / 'jobs/personaCorpus').glob('*') if p.is_dir()}
    prefix = batch.persona.split('-')[0] + '-'
    for line in result.stdout.splitlines()[1:]:
        parts = line.split('\t')
        if len(parts) >= 3:
            names.add(parts[1])
    name = prefix + batch.batch
    suffix = 1
    original = name
    while name in names:
        suffix += 1
        name = f'{original}-r{suffix}'
    # The child waits for the short admission transaction, not the planning lock.
    args = ['bin/batch', 'run', batch.persona, batch.batch, '--wait-lock']
    for flag in ('plan_only', 'review_again', 'draft_review_again', 'rebuild', 'redraft'):
        if getattr(batch.a, flag, False):
            args.append('--' + flag.replace('_', '-'))
    if batch.a.producer:
        args += ['--producer', batch.a.producer]
    result = command([job_tool(), 'start', '--repo', 'personaCorpus', '--name', name, '--command', shlex.join(args)])
    print(result.stdout, end='')


def pending_count(persona, batch):
    path = ROOT / 'progress' / persona / (batch + '.md')
    return sum(r['内容'].startswith('成形待ち：') for r in plan_rows(path)) if path.exists() else 0


def show_status(persona=None, batch=None):
    print(f'Codex 使用中 {slot_usage()} / 上限 {slot_limit()}')
    def state_label(name, number, state):
        status = state.get('status', 'new')
        if status == 'done':
            return '結果待ち'
        if status == 'running' and number not in runtime_batches(name):
            return f'中断 ({state.get("stage", "")}, 状態記録のみ)'
        labels = {'accepted': '受入済み', 'discarded': '破棄', 'failed': '失敗', 'planned': '計画済み', 'new': '未開始', 'running': '進行中'}
        return f'{labels.get(status, status)} ({state.get("stage", "")}, {status})'
    if batch:
        if not re.fullmatch(r'b\d{3,}', batch):
            raise ValueError('batch 名は b001 からの連番')
        state = ROOT / 'scratch' / persona / batch / 'state.json'
        if state.exists():
            s = json.loads(read(state))
            print(state_label(persona, batch, s))
            print(f'成形の組 {len(s.get("build_groups", {}))} / 続きを使った行 {len(s.get("build_continuations", {}))} 件')
            for group, details in sorted(s.get('active', {}).items()):
                if re.search(r'-g\d+$', group):
                    print(f'  組 {group}: {details}')
            print(f'{persona} {batch}: {s["stage"]} / {s["status"]} / {s.get("count", 0)} 件 / 原稿 合格{s.get("draft_pass", 0)} 不合格{s.get("draft_reject", 0)} / 成形 合格{s.get("build_pass", 0)} 不合格{s.get("build_reject", 0)} / 成形待ち{pending_count(persona, batch)} / {s.get("reason", "")}')
        else:
            path = ROOT / 'progress' / persona / (batch + '.result.md')
            print(read(path) if path.exists() else '依頼あり（状態なし）')
            print(f'成形待ち {pending_count(persona, batch)} 件')
        return
    names = [persona] if persona else sorted(p.stem for p in (ROOT / 'personas').glob('p[0-9][0-9]-*.md'))
    print('persona\t受入済み件数')
    for name in names:
        manifest = ROOT / 'manifests' / (name + '.tsv')
        entries = list(csv.reader(read(manifest).splitlines(), delimiter='\t')) if manifest.exists() else []
        print(f'{name}\t{len(entries)}')
        if not persona:
            continue
        counts = Counter(Path(r[0]).suffix.lstrip('.') for r in entries if r)
        definition = read(ROOT / 'personas' / (name + '.md'))
        section = re.search(r'(?ms)^##[^\n]*形式の目安[^\n]*\n(.*?)(?=^##|\Z)', definition)
        targets = {}
        if section:
            for line in section[1].splitlines():
                match = re.search(r'(.+?)(?:[：:]|\|)\s*(\d+(?:\.\d+)?)\s*%', line)
                if not match:
                    continue
                extensions = tuple(sorted(set(re.findall(r'(?<![a-z])(?:' + '|'.join(sorted(EXT)) + r')(?![a-z])', match[1]))))
                if extensions:
                    # Manifest distinguishes extensions, not text/scanned PDFs. Combine their targets.
                    targets[extensions] = targets.get(extensions, 0) + float(match[2])
        covered = {ext for group in targets for ext in group}
        for ext in counts.keys() - covered:
            targets[(ext,)] = None
        for extensions, target in sorted(targets.items()):
            count = sum(counts[e] for e in extensions)
            ratio = 100 * count / len(entries) if entries else 0
            difference = f'{ratio - target:+.1f} pt' if target is not None else '目安なし'
            print(f'  {"・".join(extensions)}: {count} 件 / {ratio:.1f}% / 差 {difference}')
        for req in sorted((ROOT / 'progress' / name).glob('*.request.md')):
            b = req.name.removesuffix('.request.md')
            state = ROOT / 'scratch' / name / b / 'state.json'
            result = req.with_name(b + '.result.md')
            label = '依頼あり'
            if result.exists():
                m = re.search(r'^状態：(.*)', read(result), re.M)
                label = m[1] if m else '結果待ち'
            if state.exists():
                s = json.loads(read(state))
                label = state_label(name, b, s)
            groups = sum(bool(re.search(r'-g\d+$', key)) for key in s.get('active', {})) if state.exists() and b in runtime_batches(name) else 0
            print(f'  {b}: {label} / 同時実行 {groups} 組 / 成形待ち {pending_count(name, b)} 件')
            if state.exists():
                for group, details in sorted(s.get('active', {}).items()):
                    if re.search(r'-g\d+$', group):
                        print(f'    組 {group}: {details}')


def show_findings(since=None, persona=None):
    if since:
        dt.date.fromisoformat(since)
    def rows(name):
        path = ROOT / 'progress' / name
        return list(csv.DictReader(read(path).splitlines(), delimiter='\t')) if path.exists() else []
    events = [r for r in rows('findings.tsv') if (not since or r['date'] >= since)
              and (not persona or r['persona'] == persona)]
    groups = defaultdict(list)
    for event in events:
        groups[(event['stage'], event['criterion'])].append(event)
    print('段階 × 観点（多い順）\t件数\t代表の理由（3件まで）')
    for (stage, criterion), items in sorted(groups.items(), key=lambda x: (-len(x[1]), x[0])):
        reasons = list(dict.fromkeys(r['reason'] for r in items))[:3]
        print(f'{stage}\t{criterion}\t{len(items)}\t' + ' / '.join(reasons))
    print('\nbatch ごとの初回の不合格率\npersona\tbatch\t日付\t原稿\t成形\t状態')
    for row in sorted(rows('batches.tsv'), key=lambda r: (r['date'], r['persona'], r['batch'])):
        if (since and row['date'] < since) or (persona and row['persona'] != persona):
            continue
        n = int(row['planned'])
        rates = [f'{int(row[k])/n:.1%}' if n else '0.0%' for k in ('draft_initial_rejects', 'build_initial_rejects')]
        print('\t'.join([row['persona'], row['batch'], row['date'], *rates, row['status']]))
    improvements = ROOT / 'progress/improvements.md'
    if improvements.exists():
        print('\n改善の前後（記録日より前 / 記録日以降）')
        # Accept prose, headings or Markdown table rows containing a date and criteria.
        current_date = None
        for line in read(improvements).splitlines():
            match = re.search(r'\b(\d{4}-\d\d-\d\d)\b', line)
            if match:
                current_date = match[1]
            if not current_date:
                continue
            criteria = set(re.findall(r'\b(?:D(?:10|[1-9])|V[1-6]|other)\b', line))
            criteria.update(c for _, c in groups if c in line.split() or f'`{c}`' in line)
            for criterion in sorted(criteria):
                before = sum(r['criterion'] == criterion and r['date'] < current_date for r in events)
                after = sum(r['criterion'] == criterion and r['date'] >= current_date for r in events)
                print(f'{current_date}\t{criterion}\t{before}\t{after}')


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='action', required=True)
    for action in ('start', 'run', 'resume', 'accept', 'discard'):
        p = sub.add_parser(action)
        p.add_argument('persona')
        p.add_argument('batch')
        if action in ('start', 'run', 'resume'):
            p.add_argument('--plan-only', action='store_true')
            p.add_argument('--producer')
            p.add_argument('--review-again', action='store_true')
            p.add_argument('--draft-review-again', action='store_true')
            p.add_argument('--rebuild', action='store_true')
            p.add_argument('--redraft', action='store_true')
        if action == 'run':
            p.add_argument('--wait-lock', action='store_true', help=argparse.SUPPRESS)
        if action == 'accept':
            p.add_argument('--drop', nargs='+', action='extend', default=[])
        if action == 'discard':
            p.add_argument('--reason', required=True)
    p = sub.add_parser('status')
    p.add_argument('persona', nargs='?')
    p.add_argument('batch', nargs='?')
    p = sub.add_parser('templates')
    p.add_argument('persona')
    p.add_argument('--fix', required=True)
    p = sub.add_parser('findings')
    p.add_argument('--since')
    p.add_argument('--persona')
    a = parser.parse_args(argv)
    if a.action == 'findings':
        show_findings(a.since, persona_name(a.persona) if a.persona else None)
        return 0
    if a.action == 'templates':
        # A maintenance run has its own scratch and never changes a production plan.
        a.batch = 'b000'
        b = Batch(a)
        with persona_lock(b.persona):
            b.batch = f'templates-{time.time_ns()}'
            b.scratch = ROOT / 'scratch' / b.persona / b.batch
            b.state_path = b.scratch / 'state.json'
            b.state = {'completed': {}, 'timings': {}, 'status': 'new', 'stage': 'templates-review'}
            b.scratch.mkdir(parents=True, exist_ok=True)
            b.request = b.scratch / 'templates.request.md'
            b.request.write_text('# 型の修正\n' + a.fix + '\n')
            b.planning = True
            try:
                b.review_templates(a.fix)
            finally:
                b.planning = False
                b.record_tables(templates_only=True)
        return 0
    if a.action == 'status':
        show_status(persona_name(a.persona) if a.persona else None, a.batch)
        return 0
    b = Batch(a)
    if a.action in ('start', 'resume'):
        launch(b)
    elif a.action == 'run':
        with contextlib.ExitStack() as stack:
            with repository_lock('admission'):
                jobs = command([job_tool(), 'status', '--repo', 'personaCorpus']).stdout if Path(job_tool()).exists() else ''
                admit_batch(b, jobs, allow_current=getattr(a, 'wait_lock', False))
                stack.enter_context(batch_lock(b.persona, b.batch))
            b.run()
    else:
        b.finish(a.action == 'discard')
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (ValueError, OSError, KeyError) as exc:
        print(f'batch: {str(exc).splitlines()[0]}', file=sys.stderr)
        sys.exit(1)
