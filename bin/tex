#!/usr/bin/env -S uv run python
"""Build LuaLaTeX in a temporary directory and export only a clean PDF."""
import argparse
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

from pypdf import PdfReader, PdfWriter


def diagnostics(log):
    lines = log.splitlines()
    indices = [i for i, line in enumerate(lines) if line.startswith('!') or re.search(r':\d+:|Emergency stop|Fatal error', line)]
    if not indices:
        return '\n'.join(lines[-35:])
    selected = set()
    for i in indices:
        selected.update(range(max(0, i - 2), min(len(lines), i + 9)))
    return '\n'.join(lines[i] for i in sorted(selected))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('file', type=Path)
    parser.add_argument('output', type=Path)
    args = parser.parse_args()
    source, output = args.file.resolve(), args.output.resolve()
    if not source.is_file() or source.suffix.lower() != '.tex':
        parser.error('input must be an existing .tex file')
    if output.suffix.lower() != '.pdf' or output == source:
        parser.error('output must be a separate .pdf file')
    if not shutil.which('lualatex'):
        parser.error('lualatex なし')
    with tempfile.TemporaryDirectory(prefix='tex-') as directory:
        work = Path(directory)
        env = os.environ.copy()
        env['TEXINPUTS'] = str(source.parent) + os.pathsep + env.get('TEXINPUTS', '')
        env['TEXMFOUTPUT'] = str(work)
        env['TEXMFVAR'] = str(work / 'texmf-var')
        env['TEXMFCACHE'] = str(work / 'texmf-cache')
        (work / 'texmf-var').mkdir()
        (work / 'texmf-cache').mkdir()
        previous = None
        for attempt in range(6):
            result = subprocess.run([
                'lualatex', '-no-shell-escape', '-interaction=nonstopmode',
                '-halt-on-error', '-file-line-error', '-jobname=document', str(source),
            ], cwd=work, env=env, capture_output=True, text=True, errors='replace', timeout=180)
            logfile = work / 'document.log'
            log = logfile.read_text(errors='replace') if logfile.exists() else result.stdout + result.stderr
            if result.returncode or not (work / 'document.pdf').is_file():
                raise ValueError('LuaLaTeX failed:\n' + diagnostics(log))
            state = {p.name: p.read_bytes() for p in work.iterdir()
                     if p.suffix in ('.aux', '.toc', '.out', '.lof', '.lot')}
            rerun = re.search(r'Rerun to get|Please rerun|Label\(s\) may have changed', log, re.I)
            if not rerun and (not state or state == previous):
                break
            previous = state
        else:
            raise ValueError('LuaLaTeX did not converge after 6 runs:\n' + diagnostics(log))
        writer = PdfWriter(clone_from=PdfReader(work / 'document.pdf'))
        writer.metadata = None
        writer.xmp_metadata = None
        cleaned = work / 'clean.pdf'
        writer.write(cleaned)
        output.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(cleaned, output)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        print(f'tex: {exc}', file=sys.stderr)
        sys.exit(1)
