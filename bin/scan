#!/usr/bin/env -S uv run python
"""Make a deterministic, image-only, JPEG-compressed scanned PDF."""
import argparse
import io
from pathlib import Path
import subprocess
import sys
import tempfile

import numpy as np
from PIL import Image, ImageOps
from reportlab import rl_config
from reportlab.lib.utils import ImageReader
from reportlab.pdfgen.canvas import Canvas


def quality(value):
    number = int(value)
    if not 1 <= number <= 100:
        raise argparse.ArgumentTypeError('quality must be between 1 and 100')
    return number


def scanned(image, rng, gray):
    image = ImageOps.exif_transpose(image).convert('RGBA')
    paper = Image.new('RGBA', image.size, 'white')
    paper.alpha_composite(image)
    image = paper.convert('RGB').rotate(float(rng.uniform(-0.35, 0.35)),
                                        resample=Image.Resampling.BICUBIC, fillcolor='white')
    if gray:
        image = image.convert('L')
    width, height = image.size
    # A smooth, low-resolution illumination field plus fine paper/sensor noise.
    field = rng.uniform(0.965, 1.005, (5, 5)).astype('float32')
    shade = np.asarray(Image.fromarray(field).resize((width, height), Image.Resampling.BICUBIC))
    noise = rng.normal(0, 1.3, (height, width)).astype('float32')
    pixels = np.asarray(image, dtype=np.float32)
    if not gray:
        shade, noise = shade[:, :, None], noise[:, :, None]
    return Image.fromarray(np.clip(pixels * shade + noise, 0, 255).astype('uint8'))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('file', type=Path)
    parser.add_argument('output', type=Path)
    parser.add_argument('--seed', type=int, default=0)
    parser.add_argument('--quality', type=quality, default=55)
    parser.add_argument('--gray', action='store_true')
    args = parser.parse_args()
    source, output = args.file.resolve(), args.output.resolve()
    if not source.is_file():
        parser.error('input file does not exist')
    if output.suffix.lower() != '.pdf' or source == output:
        parser.error('output must be a separate .pdf file')
    if source.suffix.lower() not in ('.pdf', '.png', '.jpg', '.jpeg', '.tif', '.tiff', '.bmp', '.webp'):
        parser.error('input must be PDF or an image')
    if args.seed < 0:
        parser.error('seed must be nonnegative')
    rng = np.random.default_rng(args.seed)
    with tempfile.TemporaryDirectory(prefix='scan-') as directory:
        work = Path(directory)
        sizes = None
        if source.suffix.lower() == '.pdf':
            from pypdf import PdfReader
            sizes = []
            for page in PdfReader(source).pages:
                size = (float(page.mediabox.width), float(page.mediabox.height))
                sizes.append(size[::-1] if page.rotation % 180 else size)
            subprocess.run(['pdftoppm', '-r', '180', '-png', str(source), str(work / 'page')],
                           check=True, timeout=180)
            pages = sorted(work.glob('page-*.png'), key=lambda p: int(p.stem.split('-')[-1]))
        else:
            pages = [source]
        if not pages:
            raise ValueError('input has no pages')
        rl_config.useA85 = False
        pdf = work / 'scan.pdf'
        canvas = Canvas(str(pdf), invariant=1, pageCompression=1)
        # No user-supplied metadata, local dates, or environment identifiers.
        canvas.setAuthor('')
        canvas.setCreator('')
        canvas.setTitle('')
        for i, page in enumerate(pages):
            with Image.open(page) as image:
                result = scanned(image, rng, args.gray)
            size = sizes[i] if sizes else (result.width * 72 / 180, result.height * 72 / 180)
            canvas.setPageSize(size)
            encoded = io.BytesIO()
            result.save(encoded, 'JPEG', quality=args.quality, optimize=False, progressive=False)
            encoded.seek(0)
            canvas.drawImage(ImageReader(encoded), 0, 0, width=size[0], height=size[1])
            canvas.showPage()
        canvas.save()
        # ReportLab's invariant dates are fixed, but remove Info entirely as well.
        from pypdf import PdfReader, PdfWriter
        writer = PdfWriter(clone_from=PdfReader(pdf))
        writer.metadata = None
        writer.xmp_metadata = None
        clean = work / 'clean.pdf'
        writer.write(clean)
        output.parent.mkdir(parents=True, exist_ok=True)
        output.write_bytes(clean.read_bytes())


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        print(f'scan: {exc}', file=sys.stderr)
        sys.exit(1)
