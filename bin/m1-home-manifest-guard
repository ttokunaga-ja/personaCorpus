#!/usr/bin/env python3
"""Verify one accepted persona home against the root corpus manifest."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import stat
import sys
from pathlib import Path
from typing import NoReturn


SCHEMA = "persona-corpus.git-corpus-manifest/v1"
PERSONA_RE = re.compile(r"p[0-9]{2}")
SHA256_RE = re.compile(r"[0-9a-f]{64}")


def fail(message: str) -> NoReturn:
    print(f"m1-home-manifest-guard: {message}", file=sys.stderr)
    raise SystemExit(1)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="verify an accepted persona home and emit sorted relative paths"
    )
    parser.add_argument("--home", required=True)
    parser.add_argument("--manifest", required=True)
    parser.add_argument("--persona", required=True)
    parser.add_argument("--prefix", required=True)
    return parser.parse_args()


def validate_relative_path(relative: str) -> None:
    parts = relative.split("/")
    if (
        not relative
        or relative.startswith("/")
        or any(part in {"", ".", ".."} for part in parts)
        or any(character in relative for character in ("\n", "\r", "\t"))
        or any(part.casefold() == "__pycache__" for part in parts)
        or relative.casefold().endswith(".pyc")
    ):
        fail(f"unsafe manifest artifact path: {relative!r}")


def safe_relative_path(value: object, prefix: str) -> str:
    if not isinstance(value, str) or not value.startswith(prefix):
        fail("manifest artifact path is outside the persona prefix")
    relative = value[len(prefix) :]
    validate_relative_path(relative)
    return relative


def load_expected(manifest: Path, persona: str, prefix: str) -> dict[str, tuple[int, str]]:
    records: list[dict[str, object]] = []
    try:
        with manifest.open("r", encoding="utf-8") as handle:
            for line_number, line in enumerate(handle, start=1):
                if not line.strip():
                    fail(f"blank manifest record at line {line_number}")
                value = json.loads(line)
                if not isinstance(value, dict):
                    fail(f"non-object manifest record at line {line_number}")
                records.append(value)
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        fail(f"cannot parse manifest: {exc}")

    headers = [row for row in records if row.get("kind") == "header"]
    artifacts = [row for row in records if row.get("kind") == "artifact"]
    if len(headers) != 1 or headers[0].get("schema") != SCHEMA:
        fail("manifest must contain one accepted schema header")
    if headers[0].get("artifact_count") != len(artifacts):
        fail("manifest header artifact count does not match its records")

    expected: dict[str, tuple[int, str]] = {}
    for row in artifacts:
        if row.get("persona") != persona:
            continue
        if row.get("schema") != SCHEMA:
            fail("persona artifact uses an unexpected manifest schema")
        relative = safe_relative_path(row.get("path"), prefix)
        byte_count = row.get("bytes")
        digest = row.get("sha256")
        if (
            isinstance(byte_count, bool)
            or not isinstance(byte_count, int)
            or byte_count < 0
            or not isinstance(digest, str)
            or SHA256_RE.fullmatch(digest) is None
        ):
            fail(f"invalid size or SHA-256 for manifest artifact: {relative}")
        if relative in expected:
            fail(f"duplicate manifest artifact path: {relative}")
        expected[relative] = (byte_count, digest)

    if not expected:
        fail(f"manifest contains no artifacts for {persona}")
    return expected


def load_actual(home: Path) -> dict[str, Path]:
    actual: dict[str, Path] = {}
    for directory, directory_names, file_names in os.walk(home, followlinks=False):
        directory_path = Path(directory)
        for name in directory_names + file_names:
            entry = directory_path / name
            relative = entry.relative_to(home).as_posix()
            validate_relative_path(relative)
            try:
                mode = entry.lstat().st_mode
            except OSError as exc:
                fail(f"cannot inspect home entry {relative}: {exc}")
            if stat.S_ISLNK(mode):
                fail(f"home contains a symlink: {relative}")
            if name in directory_names:
                if not stat.S_ISDIR(mode):
                    fail(f"home contains a non-directory entry: {relative}")
            elif not stat.S_ISREG(mode):
                fail(f"home contains a non-regular artifact: {relative}")
        for name in file_names:
            entry = directory_path / name
            relative = entry.relative_to(home).as_posix()
            if relative in actual:
                fail(f"duplicate physical artifact path: {relative}")
            actual[relative] = entry
    return actual


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def main() -> None:
    args = parse_args()
    if PERSONA_RE.fullmatch(args.persona) is None:
        fail(f"invalid persona: {args.persona}")
    expected_prefix = f"workspace/people/{args.persona}-"
    if not args.prefix.startswith(expected_prefix) or not args.prefix.endswith("/home/"):
        fail("manifest prefix does not match the selected persona")

    home_argument = Path(args.home)
    manifest = Path(args.manifest)
    if home_argument.is_symlink() or not home_argument.is_dir():
        fail("home must be a physical directory")
    if manifest.is_symlink() or not manifest.is_file():
        fail("manifest must be a regular non-symlink file")
    try:
        home = home_argument.resolve(strict=True)
    except OSError as exc:
        fail(f"cannot resolve home: {exc}")
    lexical_home = Path(os.path.abspath(home_argument))
    if home != lexical_home:
        fail("home path traverses a symlinked ancestor")

    expected = load_expected(manifest, args.persona, args.prefix)
    actual = load_actual(home)
    missing = sorted(expected.keys() - actual.keys())
    extra = sorted(actual.keys() - expected.keys())
    if missing or extra:
        fail(
            "home path set does not exactly match the accepted manifest persona subset "
            f"(missing={len(missing)}, extra={len(extra)})"
        )

    for relative in sorted(expected):
        path = actual[relative]
        expected_bytes, expected_sha256 = expected[relative]
        observed_bytes = path.stat().st_size
        if observed_bytes != expected_bytes:
            fail(f"byte-count mismatch for accepted artifact: {relative}")
        if sha256(path) != expected_sha256:
            fail(f"SHA-256 mismatch for accepted artifact: {relative}")
        print(relative)


if __name__ == "__main__":
    main()
