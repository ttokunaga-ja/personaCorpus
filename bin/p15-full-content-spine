#!/usr/bin/env python3
"""Normalize and fail-close validate p15's unaccepted Full content references."""
from __future__ import annotations

import hashlib
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
LEDGER = ROOT / "progress/p15/full/full-assignment-ledger.jsonl"
REPORT = ROOT / "progress/p15/full/remediation/content-spine-reference-remediation.json"
COMMON = ("org.orchid-people",)
TAIL = ("date.2026-08-18", "period.2026-q3", "term.no-kio-claim")
SCOPE = {
 "p15-primary-01": ("program.requisition-alpha","control.synthetic-identity","rel.alpha-candidate-pipeline"),
 "p15-primary-02": ("program.requisition-alpha","measure.openings-3","rel.alpha-interview-loop"),
 "p15-primary-03": ("program.requisition-beta","control.synthetic-identity","rel.beta-candidate-pipeline"),
 "p15-primary-04": ("program.requisition-beta","measure.openings-3","rel.beta-interview-loop"),
 "p15-primary-05": ("program.requisition-alpha","measure.jpy-band-7.2-8.4m","rel.offer-governance"),
 "p15-primary-06": ("control.minimized-people-data","period.2026-q3","rel.people-policy"),
 "p15-primary-07": ("measure.openings-3","measure.jpy-band-7.2-8.4m","rel.headcount-plan"),
 "p15-primary-08": ("control.synthetic-identity","period.2026-q3","rel.performance-synthetic"),
 "p15-primary-09": ("control.minimized-people-data","period.2026-q3","rel.survey-synthetic"),
 "p15-primary-10": ("program.requisition-alpha","period.2026-q3","rel.training-readiness"),
 "p15-primary-11": ("measure.jpy-band-7.2-8.4m","control.minimized-people-data","rel.compensation-governance"),
 "p15-primary-12": ("control.minimized-people-data","date.2026-08-18","rel.retention-compliance"),
 "p15-secondary-01": ("program.requisition-alpha","date.2026-08-18","rel.desktop-working"),
 "p15-secondary-02": ("control.synthetic-identity","control.minimized-people-data","rel.reference-library"),
 "p15-secondary-03": ("program.requisition-beta","date.2026-08-18","rel.inbox-intake"),
 "p15-secondary-04": ("measure.openings-3","period.2026-q3","rel.export-review"),
 "p15-secondary-05": ("program.requisition-alpha","measure.jpy-band-7.2-8.4m","rel.personal-workspace"),
 "p15-secondary-06": ("control.minimized-people-data","period.2026-q3","rel.shared-people-ops"),
 "p15-secondary-07": ("program.requisition-beta","date.2026-08-18","rel.recruiting-mail"),
 "p15-secondary-08": ("control.minimized-people-data","period.2026-q3","rel.closed-archive"),
}

def fail(message: str) -> None: raise SystemExit(f"p15-full-content-spine: {message}")
def sha(data: bytes) -> str: return hashlib.sha256(data).hexdigest()
def refs(scope: str) -> list[str]:
    if scope not in SCOPE: fail(f"unknown scope: {scope}")
    return list(dict.fromkeys((*COMMON, *SCOPE[scope], *TAIL)))
def invariant(row: dict) -> bytes:
    copy = dict(row); copy.pop("content_spine_ids", None)
    return json.dumps(copy, ensure_ascii=False, separators=(",", ":"), sort_keys=True).encode() + b"\n"
def load() -> list[dict]:
    try: return [json.loads(line) for line in LEDGER.read_text(encoding="utf-8").splitlines()]
    except Exception as exc: fail(f"cannot parse canonical ledger: {exc}")
def validate(rows: list[dict]) -> None:
    if len(rows) != 7801 or rows[0].get("artifact_count") != 7800: fail("ledger count/header mismatch")
    used=set(); seen=set()
    for row in rows[1:]:
        if row.get("kind") != "artifact" or row.get("persona") != "p15": fail("non-p15 artifact row")
        scope=row.get("scope_id"); actual=row.get("content_spine_ids")
        expected=refs(scope)
        if actual != expected: fail(f"scope mapping mismatch: {row.get('artifact_id')}")
        if len(actual) != len(set(actual)): fail(f"duplicate content reference: {row.get('artifact_id')}")
        key=(row.get("artifact_id"),row.get("source_id"),row.get("path"))
        if key in seen: fail(f"duplicate allocation identity: {row.get('artifact_id')}")
        seen.add(key); used.update(actual)
        alpha="program.requisition-alpha" in actual; beta="program.requisition-beta" in actual
        if "primary-01" in scope or "primary-02" in scope or "primary-05" in scope or "primary-10" in scope or scope in {"p15-secondary-01","p15-secondary-05"}:
            if not alpha or beta: fail(f"alpha scope mapping mismatch: {scope}")
        elif scope in {"p15-primary-03","p15-primary-04","p15-secondary-03","p15-secondary-07"}:
            if not beta or alpha: fail(f"beta scope mapping mismatch: {scope}")
        elif alpha or beta: fail(f"shared People Ops scope has requisition leakage: {scope}")
    declared=set(COMMON+TAIL)
    for values in SCOPE.values(): declared.update(values)
    if used != declared: fail("declared and used content identifiers differ")

def main() -> None:
    if len(sys.argv) != 2 or sys.argv[1] not in {"normalize", "verify"}:
        fail("usage: p15-full-content-spine normalize|verify")
    before=LEDGER.read_bytes(); rows=load()
    if sys.argv[1] == "normalize":
        for row in rows[1:]: row["content_spine_ids"] = refs(row["scope_id"])
        validate(rows)
        rendered="".join(json.dumps(row,ensure_ascii=False,separators=(",", ":"))+"\n" for row in rows).encode()
        if sha(b"".join(invariant(row) for row in load())) != sha(b"".join(invariant(row) for row in rows)):
            fail("non-reference field drift")
        LEDGER.write_bytes(rendered)
        REPORT.parent.mkdir(parents=True, exist_ok=True)
        report={"schema":"persona-corpus.p15-content-spine-remediation/v1","persona":"p15","kind":"content-spine-reference-remediation","reason":"remove duplicate per-row references and apply declared scope subjects","before_sha256":"sha256:"+sha(before),"after_sha256":"sha256:"+sha(rendered),"artifact_count":7800,"changed_field":"content_spine_ids","invariant_projection_sha256":"sha256:"+sha(b"".join(invariant(row) for row in rows)),"scope_mapping":{scope:refs(scope) for scope in sorted(SCOPE)},"state":"unaccepted"}
        REPORT.write_text(json.dumps(report,ensure_ascii=False,separators=(",", ":"))+"\n",encoding="utf-8")
    validate(load())
    print(json.dumps({"persona":"p15","result":"ok","artifact_count":7800,"scope_count":20,"content_reference_duplicates":0},separators=(",", ":")))
if __name__ == "__main__": main()
