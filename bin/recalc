#!/usr/bin/env -S uv run python
"""Cache XLSX formula results using an isolated LibreOffice process."""
import argparse
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
from xml.dom import minidom
import zipfile

NS = 'http://schemas.openxmlformats.org/spreadsheetml/2006/main'
REL = 'http://schemas.openxmlformats.org/officeDocument/2006/relationships'


def sheets(archive):
    import posixpath
    rels = minidom.parseString(archive.read('xl/_rels/workbook.xml.rels'))
    targets = {n.getAttribute('Id'): n.getAttribute('Target') for n in rels.documentElement.childNodes if n.nodeType == n.ELEMENT_NODE}
    book = minidom.parseString(archive.read('xl/workbook.xml'))
    return {n.getAttribute('name'): posixpath.normpath('xl/' + targets[n.getAttributeNS(REL,'id')])
            if not targets[n.getAttributeNS(REL,'id')].startswith('/') else targets[n.getAttributeNS(REL,'id')][1:]
            for n in book.getElementsByTagNameNS(NS,'sheet')}


def recalc(source):
    source = source.absolute()
    if source.is_symlink() or not source.is_file() or source.suffix.lower() != '.xlsx':
        raise ValueError('input must be an existing regular XLSX file')
    if not shutil.which('soffice'):raise ValueError('soffice なし')
    with tempfile.TemporaryDirectory(prefix='recalc-') as directory:
        work = Path(directory)
        incoming = work / 'input' / source.name
        incoming.parent.mkdir()
        # Calc may trust stale caches in manual-calculation workbooks. In the
        # disposable input only, discard caches and request full calculation.
        with zipfile.ZipFile(source) as original, zipfile.ZipFile(incoming,'w') as prepared:
            for entry in original.infolist():
                data = original.read(entry)
                if entry.filename.startswith('xl/worksheets/') and entry.filename.endswith('.xml'):
                    doc = minidom.parseString(data)
                    for cell in doc.getElementsByTagNameNS(NS,'c'):
                        if not cell.getElementsByTagNameNS(NS,'f'):continue
                        for child in list(cell.childNodes):
                            if child.nodeType == child.ELEMENT_NODE and child.localName in ('v','is'):cell.removeChild(child)
                        if cell.hasAttribute('t'):cell.removeAttribute('t')
                    data = doc.toxml(encoding='UTF-8')
                elif entry.filename == 'xl/workbook.xml':
                    doc = minidom.parseString(data)
                    nodes = doc.getElementsByTagNameNS(NS,'calcPr')
                    calc = nodes[0] if nodes else doc.createElementNS(NS,'calcPr')
                    if not nodes:doc.documentElement.appendChild(calc)
                    for key,value in [('calcMode','auto'),('fullCalcOnLoad','1'),('forceFullCalc','1')]:calc.setAttribute(key,value)
                    data = doc.toxml(encoding='UTF-8')
                prepared.writestr(entry,data)
        result = subprocess.run(['soffice', '-env:UserInstallation=' + (work/'profile').as_uri(),
                                 '--headless', '--convert-to', 'xlsx:Calc MS Excel 2007 XML',
                                 '--outdir', str(work), str(incoming)], capture_output=True, text=True, timeout=180)
        calculated = work / (source.stem + '.xlsx')
        if result.returncode or not calculated.is_file():
            raise ValueError('LibreOffice recalculation failed:\n' + result.stdout + result.stderr)
        # Retain original formulas and all layout/metadata parts. Only copy the
        # cached values from Calc, whose XLSX export can otherwise alter styles.
        with zipfile.ZipFile(source) as original, zipfile.ZipFile(calculated) as computed:
            old_sheets, new_sheets = sheets(original), sheets(computed)
            replacements = {}
            for name, part in old_sheets.items():
                doc = minidom.parseString(original.read(part))
                formulas = [c for c in doc.getElementsByTagNameNS(NS,'c') if c.getElementsByTagNameNS(NS,'f')]
                if not formulas:continue
                if name not in new_sheets:raise ValueError('recalculated sheet missing: ' + name)
                cached = minidom.parseString(computed.read(new_sheets[name]))
                cells = {c.getAttribute('r'):c for c in cached.getElementsByTagNameNS(NS,'c')}
                for cell in formulas:
                    address = cell.getAttribute('r'); value = cells.get(address)
                    values = value.getElementsByTagNameNS(NS,'v') if value is not None else []
                    if not values:raise ValueError(f'cached result missing: {name}!{address}')
                    for child in list(cell.childNodes):
                        if child.nodeType == child.ELEMENT_NODE and child.localName in ('v','is'):cell.removeChild(child)
                    if value.hasAttribute('t'):cell.setAttribute('t',value.getAttribute('t'))
                    elif cell.hasAttribute('t'):cell.removeAttribute('t')
                    # Calc writes formula strings as t="str", independent of its shared strings table.
                    if cell.getAttribute('t') in ('s','inlineStr'):raise ValueError('unsupported formula cache type')
                    cell.appendChild(doc.importNode(values[0],True))
                replacements[part] = doc.toxml(encoding='UTF-8')
            with tempfile.NamedTemporaryFile(prefix='.'+source.name+'.',suffix='.tmp',dir=source.parent,delete=False) as out:
                temporary = Path(out.name)
            try:
                with zipfile.ZipFile(temporary,'w') as out:
                    for entry in original.infolist():out.writestr(entry,replacements.get(entry.filename,original.read(entry)))
                temporary.chmod(source.stat().st_mode)
                temporary.replace(source)
            finally:temporary.unlink(missing_ok=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('file',type=Path)
    args = parser.parse_args()
    recalc(args.file)


if __name__ == '__main__':
    try:main()
    except (OSError,ValueError,zipfile.BadZipFile,subprocess.SubprocessError) as exc:
        print(f'recalc: {exc}',file=sys.stderr); sys.exit(1)
