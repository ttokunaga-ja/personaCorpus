#!/usr/bin/env -S uv run python
"""Set deterministic internal document properties without changing the body."""
import argparse
import datetime as dt
import io
from pathlib import Path
import re
import struct
import sys
import tempfile
from xml.dom import minidom
import zipfile
import zlib
from zoneinfo import ZoneInfo

TOOL = re.compile(r'python|openpyxl|reportlab|pypdf|pillow|matplotlib|codex|chatgpt|openai|imagegen|(?:lua|pdf|xe)?latex|(?:lua|pdf|xe)tex|tesseract|ghostscript|libreoffice|/Users/|/home/|/tmp/|scratch/', re.I)
CP = 'http://schemas.openxmlformats.org/package/2006/metadata/core-properties'
DC = 'http://purl.org/dc/elements/1.1/'
DCT = 'http://purl.org/dc/terms/'
APP = 'http://schemas.openxmlformats.org/officeDocument/2006/extended-properties'


def iso(value):
    return value.astimezone(dt.timezone.utc).isoformat(timespec='seconds').replace('+00:00', 'Z')


def xml_property(document, namespace, name, value, prefix=''):
    nodes = document.getElementsByTagNameNS(namespace, name)
    if nodes:
        node = nodes[0]
        for duplicate in list(nodes)[1:]: duplicate.parentNode.removeChild(duplicate)
    else:
        node = document.createElementNS(namespace, (prefix + ':' if prefix else '') + name)
        document.documentElement.appendChild(node)
    for child in list(node.childNodes): node.removeChild(child)
    node.appendChild(document.createTextNode(value))
    return node


def office_xml(raw, name, author, date, ext, modified_by=None, created=None):
    doc = minidom.parseString(raw)
    if name == 'docProps/core.xml':
        root = doc.documentElement
        for prefix, namespace in [('dc',DC),('cp',CP),('dcterms',DCT),('xsi','http://www.w3.org/2001/XMLSchema-instance')]:
            root.setAttribute('xmlns:'+prefix, namespace)
        for namespace, local, value, prefix in [(DC,'creator',author,'dc'),(CP,'lastModifiedBy',modified_by or author,'cp'),(DCT,'created',iso(created or date),'dcterms'),(DCT,'modified',iso(date),'dcterms')]:
            node = xml_property(doc,namespace,local,value,prefix)
            if local in ('created','modified'): node.setAttribute('xsi:type','dcterms:W3CDTF')
        # Properties may contain library names in free-text fields too.
        for node in list(root.childNodes):
            if node.nodeType == node.ELEMENT_NODE and node.localName not in ('creator','lastModifiedBy','created','modified'):
                text = ''.join(n.data for n in node.childNodes if n.nodeType == n.TEXT_NODE)
                if TOOL.search(text) or node.localName == 'lastPrinted': root.removeChild(node)
    elif name == 'docProps/app.xml':
        application = {'docx':'Microsoft Office Word','xlsx':'Microsoft Excel','pptx':'Microsoft Office PowerPoint'}[ext]
        doc.documentElement.setAttribute('xmlns',APP)
        xml_property(doc,APP,'Application',application)
        xml_property(doc,APP,'AppVersion','16.0000')
        for node in list(doc.documentElement.childNodes):
            if node.nodeType == node.ELEMENT_NODE and node.localName not in ('Application','AppVersion'):
                text = ''.join(n.data for n in node.childNodes if n.nodeType == n.TEXT_NODE)
                if TOOL.search(text): doc.documentElement.removeChild(node)
    else:
        revisions = {'comment','commentEx','ins','del','moveFrom','moveTo','rPrChange',
                     'pPrChange','sectPrChange','tblPrChange','tblGridChange','trPrChange',
                     'tcPrChange','numberingChange','cellIns','cellDel','cellMerge','cm'}
        for node in doc.getElementsByTagName('*'):
            if node.localName == 'author':
                for child in node.childNodes:
                    if child.nodeType == child.TEXT_NODE and TOOL.search(child.data): child.data = author
            is_revision = node.localName in revisions or node.localName.endswith('PrChange')
            for attr in list(node.attributes.values()):
                is_author = attr.localName in ('author','initials') or node.localName == 'cmAuthor' and attr.localName == 'name'
                if is_author and TOOL.search(attr.value): attr.value = author
                if not is_revision or attr.localName not in ('date','dateUtc','dt'): continue
                try:
                    stamp = dt.datetime.fromisoformat(attr.value.replace('Z','+00:00'))
                    if stamp.tzinfo is None: stamp = stamp.replace(tzinfo=date.tzinfo)
                    if stamp > date: attr.value = iso(date)
                except ValueError: pass
    return doc.toxml(encoding='UTF-8')


def archive_bytes(raw, author, date, ext, modified_by=None, created=None):
    out = io.BytesIO()
    # ZIP stores local wall time at two-second resolution, restricted to 1980–2107.
    if not 1980 <= date.year <= 2107: raise ValueError('ZIP date must be in 1980..2107')
    stamp = (*date.timetuple()[:5], date.second // 2 * 2)
    with zipfile.ZipFile(io.BytesIO(raw)) as source, zipfile.ZipFile(out,'w') as target:
        for old in source.infolist():
            data = source.read(old)
            if ext in ('docx','xlsx','pptx') and old.filename.endswith('.xml') and old.filename.startswith(('docProps/','word/','xl/','ppt/')):
                data = office_xml(data,old.filename,author,date,ext,modified_by,created)
            entry = zipfile.ZipInfo(old.filename, stamp)
            entry.compress_type = old.compress_type
            entry.external_attr = old.external_attr
            entry.create_system = old.create_system
            entry.internal_attr = old.internal_attr
            # Extra timestamp fields and archive comments can contain production times.
            target.writestr(entry,data)
    return out.getvalue()


def pdf_bytes(raw, author, date, producer, created=None):
    from pypdf import PdfReader, PdfWriter
    reader = PdfReader(io.BytesIO(raw))
    if not producer:
        old = str(reader.metadata or {})
        if re.search('Word',old,re.I): producer='Microsoft® Word for Microsoft 365'
        elif re.search('Excel',old,re.I): producer='Microsoft® Excel for Microsoft 365'
        elif re.search('PowerPoint|Impress',old,re.I): producer='Microsoft® PowerPoint for Microsoft 365'
        elif not any(page.extract_text().strip() for page in reader.pages): producer='Canon iR-ADV C3830'
        else: producer='Adobe PDF Library 23.0'
    writer = PdfWriter(clone_from=reader)
    metadata = {str(k):str(v) for k,v in (reader.metadata or {}).items()
                if not TOOL.search(str(v)) and not re.search(r'date|author|creator|producer', str(k), re.I)}
    pdfdate = date.astimezone(dt.timezone.utc).strftime('D:%Y%m%d%H%M%SZ')
    metadata.update({'/Author':author,'/CreationDate':(created or date).astimezone(dt.timezone.utc).strftime('D:%Y%m%d%H%M%SZ'),'/ModDate':pdfdate,'/Producer':producer,'/Creator':producer})
    writer.metadata = metadata
    writer.xmp_metadata = xmp_bytes(reader, author, date, producer, created)
    out=io.BytesIO(); writer.write(out)
    return out.getvalue()


def xmp_bytes(reader, author, date, producer, created=None):
    namespaces = {'x':'adobe:ns:meta/','rdf':'http://www.w3.org/1999/02/22-rdf-syntax-ns#','dc':DC,
                  'xmp':'http://ns.adobe.com/xap/1.0/','pdf':'http://ns.adobe.com/pdf/1.3/'}
    existing = reader.trailer['/Root'].get('/Metadata')
    if existing:
        doc = minidom.parseString(existing.get_object().get_data())
    else:
        doc = minidom.parseString('<x:xmpmeta xmlns:x="adobe:ns:meta/"/>')
    root = doc.documentElement
    for prefix,namespace in namespaces.items(): root.setAttribute('xmlns:'+prefix,namespace)
    rdf = doc.getElementsByTagNameNS(namespaces['rdf'],'RDF')
    if rdf: rdf = rdf[0]
    else:
        rdf=doc.createElementNS(namespaces['rdf'],'rdf:RDF'); root.appendChild(rdf)
    descriptions=list(doc.getElementsByTagNameNS(namespaces['rdf'],'Description'))
    owned={'author','creator','creatortool','producer','creationdate','createdate',
           'moddate','modifydate','modified','metadatadate'}
    def text(node):
        return ''.join(c.data if c.nodeType == c.TEXT_NODE else text(c)
                       for c in node.childNodes)
    for description in descriptions:
        for attr in list(description.attributes.values()):
            if attr.localName.lower() in owned or TOOL.search(attr.value): description.removeAttributeNode(attr)
        for node in list(description.childNodes):
            if node.nodeType != node.ELEMENT_NODE: continue
            if node.localName.lower() in owned or TOOL.search(text(node)) or any(TOOL.search(a.value) for a in node.attributes.values()):
                description.removeChild(node)
    description=doc.createElementNS(namespaces['rdf'],'rdf:Description')
    description.setAttribute('rdf:about',''); rdf.appendChild(description)
    for prefix,local,value in [('dc','creator',author),('xmp','CreateDate',iso(created or date)),
                               ('xmp','ModifyDate',iso(date)),('xmp','MetadataDate',iso(date)),
                               ('xmp','CreatorTool',producer),('pdf','Producer',producer)]:
        node=doc.createElementNS(namespaces[prefix],prefix+':'+local)
        description.appendChild(node)
        if local == 'creator':
            seq=doc.createElementNS(namespaces['rdf'],'rdf:Seq'); node.appendChild(seq)
            node=doc.createElementNS(namespaces['rdf'],'rdf:li'); seq.appendChild(node)
        node.appendChild(doc.createTextNode(value))
    return doc.toxml(encoding='UTF-8')


def clean_exif(raw):
    from PIL import Image
    exif = Image.Exif(); exif.load(raw)
    date_tags = {306,36867,36868,36880,36881,36882,37520,37521,37522,37500,37510}
    def clean(values):
        for key in list(values):
            if key in date_tags or TOOL.search(str(values[key])): del values[key]
    clean(exif)
    if 34665 in exif:
        values = exif.get_ifd(34665); clean(values)
        if not values: del exif[34665]
    # Embedded thumbnails may carry independent metadata; serialize retained tags only.
    return exif.tobytes()


def jpeg_exif(raw, date, device):
    from PIL import Image
    exif = Image.Exif()
    if raw: exif.load(clean_exif(raw))
    # Device identity is supplied explicitly; never retain the source GPS location.
    for tag in (271,272,34853):
        if tag in exif: del exif[tag]
    if device:
        exif[271] = device
        exif[272] = device
    stamp = date.strftime('%Y:%m:%d %H:%M:%S')
    exif[306] = stamp
    capture = exif.get_ifd(34665) if 34665 in exif else {}
    capture.update({36867:stamp, 36868:stamp})
    exif[34665] = capture
    data = exif.tobytes()
    return b'\xff\xe1' + struct.pack('>H', len(data)+2) + data


def image_bytes(raw, ext, date, device=None):
    if ext == 'png':
        result = bytearray(raw[:8]); pos=8
        while pos < len(raw):
            size = struct.unpack('>I',raw[pos:pos+4])[0]
            kind=raw[pos+4:pos+8]; data=raw[pos+8:pos+8+size]
            if kind == b'eXIf': data=clean_exif(b'Exif\0\0'+data)[6:]
            if kind not in (b'tEXt',b'zTXt',b'iTXt',b'tIME'):
                result.extend(struct.pack('>I',len(data))+kind+data+struct.pack('>I',zlib.crc32(kind+data)&0xffffffff))
            pos += size+12
        return bytes(result)
    # Copy JPEG compressed scan data verbatim; Pillow saving would recompress it.
    result=bytearray(raw[:2]); pos=2; stamped=False
    while pos < len(raw):
        start=pos
        if raw[pos] != 255: raise ValueError('invalid JPEG marker')
        while raw[pos] == 255: pos+=1
        marker=raw[pos]; pos+=1
        if marker in (0xda,0xd9):
            if not stamped: result.extend(jpeg_exif(None,date,device))
            result.extend(raw[start:]); break
        if marker == 1 or 0xd0 <= marker <= 0xd7: result.extend(raw[start:pos]); continue
        size=int.from_bytes(raw[pos:pos+2],'big'); data=raw[pos+2:pos+size]; pos+=size
        if marker == 0xfe: continue
        if marker == 0xe1:
            if data.startswith(b'Exif\0\0') and not stamped:
                result.extend(jpeg_exif(data,date,device)); stamped=True
            continue  # Discard duplicate EXIF and XMP, including extended packets.
        result.extend(bytes((255,marker))+struct.pack('>H',len(data)+2)+data)
    return bytes(result)


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('file',type=Path)
    parser.add_argument('--author',required=True)
    parser.add_argument('--date',required=True)
    parser.add_argument('--modified-by')
    parser.add_argument('--created')
    parser.add_argument('--timezone',default='UTC')
    parser.add_argument('--producer')
    parser.add_argument('--device', help='JPEG EXIF Make and Model; omitted by default')
    args=parser.parse_args()
    def timestamp(value):
        result=dt.datetime.fromisoformat(value.replace('Z','+00:00'))
        if 'T' not in value and ' ' not in value:result=result.replace(hour=12)
        if result.tzinfo is None:result=result.replace(tzinfo=ZoneInfo(args.timezone))
        return result
    date=timestamp(args.date)
    created=timestamp(args.created) if args.created else date
    if created > date:parser.error('created must not be later than date')
    if not args.file.is_file(): parser.error('file does not exist')
    raw=args.file.read_bytes(); ext=args.file.suffix.lower()[1:]
    if ext in ('docx','xlsx','pptx','zip'): result=archive_bytes(raw,args.author,date,ext,args.modified_by,created)
    elif ext == 'pdf': result=pdf_bytes(raw,args.author,date,args.producer,created)
    elif ext in ('png','jpg','jpeg'): result=image_bytes(raw,ext,date,args.device)
    else: result=raw
    with tempfile.NamedTemporaryFile(prefix='.'+args.file.name+'.', suffix='.tmp', dir=args.file.parent, delete=False) as output:
        temporary=Path(output.name)
        output.write(result)
    try:
        temporary.chmod(args.file.stat().st_mode)
        temporary.replace(args.file)
    finally: temporary.unlink(missing_ok=True)


if __name__=='__main__':
    try: main()
    except (OSError,ValueError,zipfile.BadZipFile) as exc:
        print(f'stamp: {exc}',file=sys.stderr); sys.exit(1)
