#!/usr/bin/env -S uv run python
"""Inventory accepted HEAD files plus explicitly selected batch files."""
import argparse
import csv
import datetime as dt
import hashlib
import importlib.machinery
import importlib.util
import os
from pathlib import Path
import sys
import subprocess
import tempfile
sys.dont_write_bytecode = True

loader=importlib.machinery.SourceFileLoader('corpus_check',str(Path(__file__).with_name('check')))
spec=importlib.util.spec_from_loader(loader.name,loader)
check=importlib.util.module_from_spec(spec)
loader.exec_module(check)


def accepted(folder):
    """HEAD, rather than the index, is the acceptance boundary."""
    directory=folder.resolve()
    while not directory.exists():directory=directory.parent
    result=subprocess.run(['git','-C',str(directory),'rev-parse','--show-toplevel'],capture_output=True,text=True)
    if result.returncode:raise ValueError('accepted inventory requires a Git repository')
    root=Path(result.stdout.strip()).resolve();prefix=folder.resolve().relative_to(root).as_posix()+'/'
    result=subprocess.run(['git','-C',str(root),'ls-tree','-rz','--name-only','HEAD','--',prefix],capture_output=True)
    if result.returncode:raise ValueError('accepted inventory requires Git HEAD')
    return {os.fsdecode(p)[len(prefix):] for p in result.stdout.split(b'\0') if p}


def selection(folder,includes=()):
    paths=accepted(folder)
    for rel in includes:
        path=Path(rel)
        if path.is_absolute() or '..' in path.parts or not rel or path.as_posix()!=rel:
            raise ValueError('unsafe included path: '+rel)
        paths.add(rel)
    return paths


def entries(folder,paths=None):
    for rel in sorted(accepted(folder) if paths is None else paths):
        path=folder/rel
        if not path.resolve().is_relative_to(folder.resolve()):raise ValueError(f'path escapes persona: {path}')
        if path.is_symlink():raise ValueError(f'symlink cannot be manifested: {path}')
        h=hashlib.sha256()
        with path.open('rb') as f:
            for block in iter(lambda:f.read(1024*1024),b''):h.update(block)
        st=path.stat()
        yield [path.relative_to(folder).as_posix(),h.hexdigest(),str(st.st_size),dt.datetime.fromtimestamp(st.st_mtime,dt.timezone.utc).isoformat(timespec='seconds').replace('+00:00','Z')]


def verify(folder,path,paths=None):
    with path.open(encoding='utf-8',newline='') as f:existing=list(csv.reader(f,delimiter='\t'))
    actual=list(entries(folder,paths))
    if existing!=actual:raise ValueError(f'manifest mismatch (paths, sha256, size or UTC mtime): {path}')
    return existing


def restore(folder,path):
    """Git checkouts lose modification times; put back the recorded ones for unchanged files."""
    with path.open(encoding='utf-8',newline='') as f:recorded=list(csv.reader(f,delimiter='\t'))
    if [row[0] for row in recorded]!=sorted(accepted(folder)):
        raise ValueError('manifest paths differ from accepted HEAD files')
    for rel,digest,_size,stamp in recorded:
        target=folder/rel
        if target.is_symlink() or not target.resolve().is_relative_to(folder.resolve()):raise ValueError('unsafe manifest path: '+rel)
        if not target.is_file() or hashlib.sha256(target.read_bytes()).hexdigest()!=digest:
            raise ValueError(f'cannot restore time, content differs from manifest: {rel}')
        when=dt.datetime.fromisoformat(stamp.replace('Z','+00:00')).timestamp()
        os.utime(target,(when,when))


def main():
    p=argparse.ArgumentParser(description=__doc__);p.add_argument('persona');p.add_argument('--verify',action='store_true')
    p.add_argument('--include',action='append',default=[],help='current batch path relative to persona folder (repeatable)')
    p.add_argument('--restore',action='store_true',help='set file times from the manifest (Git does not keep them)');check.options(p);a=p.parse_args()
    try:
        name=check.resolve(a.root,a.persona);output=a.manifests/(name+'.tsv')
        if a.include and (a.verify or a.restore):raise ValueError('--include is only for inventory generation')
        if a.restore:
            restore(a.root/name,output);rows=verify(a.root/name,output)
            print(f'restored {name}: {len(rows)} files');return 0
        if a.verify:
            rows=verify(a.root/name,output)
            print(f'verified {name}: {len(rows)} files')
        else:
            rows=list(entries(a.root/name,selection(a.root/name,a.include)));a.manifests.mkdir(parents=True,exist_ok=True)
            with tempfile.NamedTemporaryFile(mode='w',encoding='utf-8',newline='',dir=a.manifests,delete=False) as f:
                temporary=Path(f.name)
                try:
                    csv.writer(f,delimiter='\t',lineterminator='\n').writerows(rows)
                    f.flush();os.replace(temporary,output)
                finally:temporary.unlink(missing_ok=True)
            print(f'wrote {output}: {len(rows)} files')
        return 0
    except (OSError,ValueError,csv.Error) as e:
        print(e,file=sys.stderr);return 1

if __name__=='__main__':sys.exit(main())
