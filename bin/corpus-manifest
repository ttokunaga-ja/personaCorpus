#!/usr/bin/env python3
"""Generate or verify the Git-managed final-artifact SHA-256 manifest."""

from __future__ import annotations

import argparse
import concurrent.futures
import hashlib
import json
import os
from pathlib import Path
from pathlib import PurePosixPath
import re
import stat
import sys
import tempfile


SCHEMA = "persona-corpus.git-corpus-manifest/v1"
DEFAULT_MAX_BLOB_BYTES = 100 * 1024 * 1024
PERSONA_DIRECTORY = re.compile(r"^(p\d{2})-[a-z0-9-]+$")


class ManifestError(RuntimeError):
    pass


def sha256_file(path: Path) -> tuple[int, str]:
    digest = hashlib.sha256()
    expected = path.lstat()
    if not stat.S_ISREG(expected.st_mode) or expected.st_nlink != 1:
        raise ManifestError(f"unsafe artifact link topology: {path}")
    flags = os.O_RDONLY | getattr(os, "O_BINARY", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags)
    except OSError as error:
        raise ManifestError(f"cannot safely open artifact: {path}: {error}") from error
    with os.fdopen(descriptor, "rb") as handle:
        before = os.fstat(handle.fileno())
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_nlink != 1
            or (before.st_dev, before.st_ino) != (expected.st_dev, expected.st_ino)
        ):
            raise ManifestError(f"artifact changed before hashing: {path}")
        while chunk := handle.read(1024 * 1024):
            digest.update(chunk)
        after = os.fstat(handle.fileno())
    observed = path.lstat()
    if (
        (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns)
        != (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns)
        or (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns)
        != (observed.st_dev, observed.st_ino, observed.st_size, observed.st_mtime_ns)
    ):
        raise ManifestError(f"artifact changed while hashing: {path}")
    return before.st_size, digest.hexdigest()


def load_plan(repo_root: Path) -> tuple[str, dict[str, tuple[str, tuple[str, ...]]]]:
    plan = repo_root / "canonical" / "persona-plan.json"
    if not plan.is_file() or plan.is_symlink():
        raise ManifestError(f"portable canonical plan is missing or unsafe: {plan}")
    raw_plan = plan.read_bytes()
    try:
        value = json.loads(raw_plan)
    except json.JSONDecodeError as error:
        raise ManifestError(f"portable canonical plan is invalid JSON: {error}") from error
    personas = value.get("personas") if isinstance(value, dict) else None
    if not isinstance(personas, list) or not personas:
        raise ManifestError("portable canonical plan has no personas")

    authority: dict[str, tuple[str, tuple[str, ...]]] = {}
    for persona in personas:
        if not isinstance(persona, dict):
            raise ManifestError("portable canonical plan has an invalid persona row")
        persona_id = persona.get("id")
        role = persona.get("role")
        scopes = persona.get("scopes")
        if (
            not isinstance(persona_id, str)
            or re.fullmatch(r"p\d{2}", persona_id) is None
            or not isinstance(role, str)
            or re.fullmatch(r"[a-z0-9-]+", role) is None
            or not isinstance(scopes, list)
        ):
            raise ManifestError("portable canonical plan has an invalid persona identity")
        directory = f"{persona_id}-{role}"
        scope_paths: list[str] = []
        for scope in scopes:
            scope_path = scope.get("path") if isinstance(scope, dict) else None
            if not isinstance(scope_path, str):
                raise ManifestError(f"invalid scope path for {persona_id}")
            pure = PurePosixPath(scope_path)
            if pure.is_absolute() or not pure.parts or any(part in ("", ".", "..") for part in pure.parts):
                raise ManifestError(f"unsafe scope path for {persona_id}: {scope_path}")
            scope_paths.append(pure.as_posix())
        if directory in authority or not scope_paths:
            raise ManifestError(f"duplicate or empty persona authority: {directory}")
        authority[directory] = (persona_id, tuple(scope_paths))
    return hashlib.sha256(raw_plan).hexdigest(), authority


def collect_paths(
    repo_root: Path,
    max_blob_bytes: int,
    authority: dict[str, tuple[str, tuple[str, ...]]],
) -> list[tuple[str, str, Path]]:
    artifact_root = repo_root / "workspace" / "people"
    if not artifact_root.is_dir() or artifact_root.is_symlink():
        raise ManifestError(f"artifact root is missing: {artifact_root}")

    for child in artifact_root.iterdir():
        mode = child.lstat().st_mode
        if not stat.S_ISDIR(mode) or child.name not in authority:
            raise ManifestError(f"unexpected persona-root entry: {child}")

    rows: list[tuple[str, str, Path]] = []
    for directory, directory_names, file_names in os.walk(
        artifact_root, topdown=True, followlinks=False
    ):
        base = Path(directory)
        for name in list(directory_names):
            candidate = base / name
            if candidate.is_symlink():
                raise ManifestError(f"symlink directory is forbidden: {candidate}")
        for name in file_names:
            candidate = base / name
            relative = candidate.relative_to(repo_root).as_posix()
            if any(character in relative for character in ("\n", "\r", "\0")):
                raise ManifestError(f"control character in artifact path: {relative!r}")
            mode = candidate.lstat().st_mode
            if not stat.S_ISREG(mode) or candidate.lstat().st_nlink != 1:
                raise ManifestError(f"non-regular artifact: {candidate}")
            parts = Path(relative).parts
            if len(parts) < 5 or parts[:2] != ("workspace", "people") or parts[3] != "home":
                raise ManifestError(f"artifact outside a persona home: {relative}")
            match = PERSONA_DIRECTORY.fullmatch(parts[2])
            if match is None or parts[2] not in authority:
                raise ManifestError(f"invalid persona directory: {parts[2]}")
            persona_id, scope_paths = authority[parts[2]]
            home_relative = PurePosixPath(*parts[4:]).as_posix()
            if not any(home_relative.startswith(f"{scope_path}/") for scope_path in scope_paths):
                raise ManifestError(f"artifact outside a canonical leaf scope: {relative}")
            size = candidate.stat().st_size
            if size > max_blob_bytes:
                raise ManifestError(
                    f"artifact exceeds GitHub-compatible blob limit "
                    f"({size} > {max_blob_bytes}): {relative}"
                )
            rows.append((relative, persona_id, candidate))
    rows.sort(key=lambda row: row[0].encode("utf-8"))
    return rows


def json_line(value: dict[str, object]) -> bytes:
    return (
        json.dumps(value, ensure_ascii=False, separators=(",", ":"), sort_keys=True)
        + "\n"
    ).encode("utf-8")


def build_manifest(repo_root: Path, max_blob_bytes: int, jobs: int) -> bytes:
    plan_sha256, authority = load_plan(repo_root)
    paths = collect_paths(repo_root, max_blob_bytes, authority)

    with concurrent.futures.ThreadPoolExecutor(max_workers=jobs) as executor:
        hashes = list(executor.map(lambda row: sha256_file(row[2]), paths))

    total_bytes = sum(size for size, _ in hashes)
    largest_blob_bytes = max((size for size, _ in hashes), default=0)
    content = bytearray()
    content.extend(
        json_line(
            {
                "algorithm": "sha256",
                "artifact_count": len(paths),
                "kind": "header",
                "largest_blob_bytes": largest_blob_bytes,
                "max_blob_bytes": max_blob_bytes,
                "plan_sha256": f"sha256:{plan_sha256}",
                "schema": SCHEMA,
                "total_bytes": total_bytes,
            }
        )
    )
    for (relative, persona, _), (size, sha256) in zip(paths, hashes, strict=True):
        content.extend(
            json_line(
                {
                    "bytes": size,
                    "kind": "artifact",
                    "path": relative,
                    "persona": persona,
                    "schema": SCHEMA,
                    "sha256": sha256,
                }
            )
        )
    return bytes(content)


def write_manifest(path: Path, content: bytes, replace: bool) -> None:
    if path.exists() and not replace:
        raise ManifestError(f"output exists; pass --replace to update it: {path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.parent.is_symlink() or not path.parent.is_dir():
        raise ManifestError(f"manifest directory is unsafe: {path.parent}")
    if path.is_symlink():
        raise ManifestError(f"manifest path is a symlink: {path}")
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary_name, path)
    finally:
        if os.path.exists(temporary_name):
            os.unlink(temporary_name)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("command", choices=("generate", "verify"))
    parser.add_argument("--repo-root", type=Path, default=Path(__file__).resolve().parent.parent)
    parser.add_argument("--manifest", type=Path, required=True)
    parser.add_argument("--max-blob-bytes", type=int, default=DEFAULT_MAX_BLOB_BYTES)
    parser.add_argument("--jobs", type=int, default=min(8, os.cpu_count() or 1))
    parser.add_argument("--replace", action="store_true")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    if (
        args.max_blob_bytes <= 0
        or args.max_blob_bytes > DEFAULT_MAX_BLOB_BYTES
        or args.jobs <= 0
    ):
        raise ManifestError(
            "--jobs must be positive and --max-blob-bytes must be between 1 "
            f"and {DEFAULT_MAX_BLOB_BYTES}"
        )
    repo_root = args.repo_root.resolve()
    requested_manifest = args.manifest if args.manifest.is_absolute() else repo_root / args.manifest
    manifest = Path(os.path.abspath(requested_manifest))
    manifest_root = repo_root / "manifests"
    if manifest.parent != manifest_root or manifest.suffix != ".jsonl":
        raise ManifestError("--manifest must be a direct .jsonl child of <repo-root>/manifests")
    if manifest_root.exists() and manifest_root.is_symlink():
        raise ManifestError(f"manifest directory is a symlink: {manifest_root}")
    content = build_manifest(repo_root, args.max_blob_bytes, args.jobs)
    if args.command == "generate":
        write_manifest(manifest, content, args.replace)
        result = "written"
    else:
        if args.replace:
            raise ManifestError("--replace is valid only with generate")
        if not manifest.is_file() or manifest.is_symlink():
            raise ManifestError(f"manifest is missing or unsafe: {manifest}")
        if manifest.read_bytes() != content:
            raise ManifestError(f"manifest does not match final artifacts: {manifest}")
        result = "ok"
    header = json.loads(content.splitlines()[0])
    print(
        json.dumps(
            {
                "artifact_count": header["artifact_count"],
                "largest_blob_bytes": header["largest_blob_bytes"],
                "manifest": str(manifest),
                "result": result,
                "total_bytes": header["total_bytes"],
            },
            indent=2,
            sort_keys=True,
        )
    )
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except ManifestError as error:
        print(f"error: {error}", file=sys.stderr)
        raise SystemExit(1)
