{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ForgeLine Product Beta test record",
  "type": "object",
  "required": [
    "organization",
    "product",
    "test_date",
    "ncr",
    "tolerance_mm",
    "result"
  ],
  "properties": {
    "organization": {
      "const": "ForgeLine"
    },
    "product": {
      "const": "Product Beta"
    },
    "test_date": {
      "const": "2026-08-11"
    },
    "ncr": {
      "const": "NCR-026"
    },
    "tolerance_mm": {
      "const": 0.18
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "conditional"
      ]
    }
  }
}
