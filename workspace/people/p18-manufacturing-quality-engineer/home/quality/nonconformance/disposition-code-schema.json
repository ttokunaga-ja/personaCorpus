  "type": "object",
  "required": [
    "ncr_id",
    "event_date",
    "product",
    "disposition_code",
    "tolerance_mm"
  ],
  "properties": {
    "ncr_id": {
      "const": "NCR-026"
    },
    "event_date": {
      "const": "2026-08-11"
    },
    "product": {
      "const": "Product Alpha"
    },
    "disposition_code": {
      "enum": [
        "HOLD",
        "REWORK",
        "USE_AS_IS",
        "SCRAP"
      ]
    },
    "tolerance_mm": {
      "const": 0.18
    }
  },
  "additionalProperties": false
}
