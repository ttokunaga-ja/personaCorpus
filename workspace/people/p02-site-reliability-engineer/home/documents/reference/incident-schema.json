{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invalid/northstar-transit-cloud/incident-v1.json",
  "title": "Northstar Transit Cloud incident record",
  "type": "object",
  "additionalProperties": false,
  "required": ["incident_id", "service", "severity", "started_at", "status", "summary"],
  "properties": {
    "incident_id": {"type": "string", "pattern": "^INC-[0-9]{6}$"},
    "service": {"type": "string", "minLength": 2, "maxLength": 80},
    "severity": {"type": "string", "enum": ["SEV-1", "SEV-2", "SEV-3", "SEV-4"]},
    "started_at": {"type": "string", "format": "date-time"},
    "resolved_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["investigating", "mitigating", "resolved"]},
    "summary": {"type": "string", "minLength": 10, "maxLength": 500},
    "error_budget_remaining_percent": {"type": "number", "minimum": 0, "maximum": 100},
    "follow_up_ids": {"type": "array", "items": {"type": "string", "pattern": "^ACT-[0-9]{4}$"}, "uniqueItems": true}
  }
}
