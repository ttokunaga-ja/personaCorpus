{"nbformat":4,"nbformat_minor":5,"metadata":{"language_info":{"name":"python"}},"cells":[{"cell_type":"markdown","id":"calibration-intro","metadata":{},"source":["# Calibration reference","A compact reliability-bin summary for synthetic Model Alpha probabilities."]},{"cell_type":"code","execution_count":1,"id":"calibration-calc","metadata":{},"source":["bins=[(.55,.50,80),(.72,.70,160),(.89,.90,240)]; ece=sum(abs(c-a)*n for c,a,n in bins)/sum(n for _,_,n in bins); print(f'Alpha calibration ECE={ece:.3f}; reference F1=0.873')"],"outputs":[{"output_type":"stream","name":"stdout","text":"Alpha calibration ECE=0.020; reference F1=0.873\n"}]}]}
